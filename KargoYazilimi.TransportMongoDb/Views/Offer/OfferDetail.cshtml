@model GetOfferByIdDto

@{
    ViewData["Title"] = Model.Title;
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main">
        <section class="section pt-60 pb-60 bg-brand-2">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <div class="d-flex align-items-center mb-20">
                            <div class="icon-box bg-brand-1 p-3 rounded-3 me-3">
                                <img src="@Model.IconUrl" alt="@Model.Title" style="width: 45px; filter: brightness(0) invert(1);">
                            </div>
                            <h1 class="color-white fw-bold">@Model.Title</h1>
                        </div>
                        <p class="font-lg color-white opacity-75">Hızlı, güvenilir ve dünya standartlarında lojistik çözümleri.</p>
                    </div>
                </div>
            </div>
        </section>

        <section class="section pt-80 pb-100">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">
                        <div class="card-summary p-30 mb-40 border-radius-10" style="background: #f0f7ff; border-left: 6px solid #007bff;">
                            <h4 class="color-brand-2 mb-10">Hizmet Özeti</h4>
                            <p class="font-md color-gray-900 mb-0">@Model.ShortDescription</p>
                        </div>

                        <div class="detail-description color-gray-700">
                            @Html.Raw(Model.FullDescription)
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="sidebar-sticky ms-lg-4">

                            <div class="card-support position-relative p-40 border-radius-20 mb-30 shadow-lg overflow-hidden"
                                 style="background: linear-gradient(145deg, #002550 0%, #004a99 100%); border: none;">

                                <div class="position-absolute" style="bottom: -20px; right: -20px; opacity: 0.1; transform: rotate(-15deg);">
                                    <i class="bi bi-headset" style="font-size: 150px; color: #fff;"></i>
                                </div>

                                <div class="position-relative z-index-1">
                                    <div class="d-inline-block bg-brand-1 px-3 py-1 rounded-pill mb-20 shadow-sm">
                                        <span class="font-xs color-white fw-bold text-uppercase" style="letter-spacing: 1px;">Canlı Destek</span>
                                    </div>
                                    <h4 class="color-white fw-bold mb-15">Desteğe mi İhtiyacınız Var?</h4>
                                    <p class="font-sm color-white opacity-75 mb-30">Uzman ekibimiz size en uygun rotayı ve en rekabetçi fiyatı belirlemek için 7/24 hazır.</p>

                                    <a href="/Contact/Index" class="btn btn-white w-100 py-3 fw-bold rounded-pill shadow-sm transition-all hover-up d-flex align-items-center justify-content-center" style="color: #002550 !important; background: #fff !important;">
                                        <span>Teklif İste</span>
                                        <i class="bi bi-arrow-right-short fs-4 ms-1"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="box-advantages p-30 border-radius-20 shadow-sm bg-white border border-light">
                                <h5 class="color-brand-2 fw-bold mb-30 d-flex align-items-center">
                                    <span class="bg-primary-subtle p-2 rounded-3 me-3 text-primary">
                                        <i class="bi bi-patch-check-fill"></i>
                                    </span>
                                    Hizmet Avantajları
                                </h5>

                                <div class="advantage-list">
                                    <div class="advantage-item d-flex align-items-center mb-20 p-2 rounded-3 transition-all hover-light">
                                        <div class="icon-wrap bg-success-subtle p-3 rounded-circle me-3">
                                            <i class="bi bi-shield-check text-success fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold color-brand-2 fs-15">Tam Sigortalı Taşıma</h6>
                                            <p class="font-xs text-muted mb-0">Güvenli ve garantili sevkiyat.</p>
                                        </div>
                                    </div>

                                    <div class="advantage-item d-flex align-items-center mb-20 p-2 rounded-3 transition-all hover-light">
                                        <div class="icon-wrap bg-info-subtle p-3 rounded-circle me-3">
                                            <i class="bi bi-geo-alt-fill text-info fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold color-brand-2 fs-15">Anlık GPS Takibi</h6>
                                            <p class="font-xs text-muted mb-0">7/24 kargo konum izleme.</p>
                                        </div>
                                    </div>

                                    <div class="advantage-item d-flex align-items-center p-2 rounded-3 transition-all hover-light">
                                        <div class="icon-wrap bg-warning-subtle p-3 rounded-circle me-3">
                                            <i class="bi bi-clock-history text-warning fs-5"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold color-brand-2 fs-15">7/24 Operasyon Desteği</h6>
                                            <p class="font-xs text-muted mb-0">Kesintisiz iletişim imkanı.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")

    <style>
        /* CKEditor'den gelen HTML içeriğini dizayn eden özel CSS */
        .detail-description h3 {
            font-size: 28px;
            color: #002550;
            font-weight: 700;
            margin-top: 40px;
            margin-bottom: 15px;
        }

        .detail-description h4 {
            font-size: 22px;
            color: #007bff;
            margin-top: 25px;
        }

        .detail-description p {
            margin-bottom: 20px;
            line-height: 1.8;
            font-size: 16px;
        }

        .detail-description ul {
            margin-bottom: 25px;
            padding-left: 20px;
        }

        .detail-description li {
            margin-bottom: 10px;
            list-style-type: square;
            color: #007bff;
        }

            .detail-description li span {
                color: #444;
            }

        .detail-description table {
            width: 100% !important;
            margin: 30px 0;
            border-collapse: collapse;
        }

            .detail-description table th {
                background: #f8f9fa;
                padding: 12px;
                border: 1px solid #dee2e6;
            }

            .detail-description table td {
                padding: 12px;
                border: 1px solid #dee2e6;
            }

        .bg-brand-2 {
            background-color: #002550 !important;
        }

        .bg-brand-1 {
            background-color: #007bff !important;
        }

        /* Sidebar Modernizasyon CSS */
        .border-radius-20 {
            border-radius: 20px !important;
        }

        .card-support {
            transition: all 0.4s ease;
        }

            .card-support:hover {
                transform: translateY(-10px);
                box-shadow: 0 20px 40px rgba(0,37,80,0.2) !important;
            }

        .hover-up:hover {
            transform: scale(1.02);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .advantage-item {
            cursor: default;
        }

            .advantage-item:hover {
                background: #f8fbff;
                transform: translateX(5px);
            }

        /* Renk Paleti (Subtle Renkler) */
        .bg-success-subtle {
            background-color: #e6fcf5 !important;
        }

        .bg-info-subtle {
            background-color: #e3f2fd !important;
        }

        .bg-warning-subtle {
            background-color: #fff9db !important;
        }

        .bg-primary-subtle {
            background-color: #e7f1ff !important;
        }

        .fs-15 {
            font-size: 15px;
        }

        .font-xs {
            font-size: 12px;
        }

        .transition-all {
            transition: all 0.3s ease;
        }
    </style>
</body>
</html>