@model CreateProjectSectionDto

@{
    ViewData["Title"] = "CreateProjectSection";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<script src="https://cdn.ckeditor.com/4.22.1/standard/ckeditor.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<br />
<br />
<div class="row justify-content-center">
    <div class="col-xl-12">
        <div class="card shadow-lg border-0" style="border-radius: 15px;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-folder-plus me-2 text-primary"></i>Yeni Proje & Başarı Hikayesi Ekle
                </h5>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Proje Başlığı</label>
                                    <input type="text" asp-for="Title" id="projectTitle" class="form-control" placeholder="Örn: Hava Kargo Sevkiyatı" oninput="generateSlug(this.value)" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Slug (URL)</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">/</span>
                                        <input type="text" asp-for="Slug" id="projectSlug" class="form-control" placeholder="hava-kargo-sevkiyati" readonly>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Kısa Açıklama (Slider'da görünür)</label>
                                <textarea asp-for="ShortDescription" class="form-control" rows="2" placeholder="Müşterinin ilk göreceği kısa özet..."></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Detaylı İçerik (Full Description)</label>
                                <textarea asp-for="FullDescription" id="editor1" class="form-control"></textarea>
                                <div class="form-text mt-1 text-primary">
                                    <i class="bi bi-info-circle me-1"></i>Buradan resim, tablo ve özel fontlar ekleyebilirsiniz.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4 border-start ps-4">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Proje Kategorisi</label>
                                <select asp-for="Category" class="form-select">
                                    <option value="Hava Yolu">Hava Yolu</option>
                                    <option value="Deniz Yolu">Deniz Yolu</option>
                                    <option value="Kara Yolu">Kara Yolu</option>
                                    <option value="Depolama">Depolama</option>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Kapak Görseli URL</label>
                                <input type="text" asp-for="ImageUrl" class="form-control" placeholder="https://.../resim.jpg" oninput="previewBrandLogo(this)">
                            </div>

                            <div class="text-center p-3 border rounded-3 bg-light mb-4" style="min-height: 180px; display: flex; align-items: center; justify-content: center;">
                                <img id="brandPreview" src="#" alt="Önizleme" class="img-fluid rounded shadow-sm" style="display: none; max-height: 150px;">
                                <div id="brandPlaceholder" class="text-muted">
                                    <i class="bi bi-image display-4 d-block mb-2"></i>
                                    <span class="small">Kapak Görseli Önizlemesi</span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Sıralama</label>
                                    <input type="number" asp-for="OrderNo" class="form-control" value="1">
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold text-secondary">Durum</label>
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                                        <label class="form-check-label">Yayında</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4 pt-3 border-top">
                        <a href="/Admin/ProjectSection/Index" class="btn btn-light px-4 rounded-pill me-2">Vazgeç</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">
                            <i class="bi bi-save me-1"></i> Projeyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // CKEditor Başlatma
    CKEDITOR.replace('editor1', {
        height: 300,
        filebrowserUploadUrl: '/Admin/ProjectSection/UploadImage', // Resim yükleme desteği istersen
        removeButtons: 'About'
    });

    // Görsel Önizleme Scripti
    function previewBrandLogo(input) {
        var preview = document.getElementById('brandPreview');
        var placeholder = document.getElementById('brandPlaceholder');

        if (input.value && input.value.trim() !== "") {
            preview.src = input.value;
            preview.style.display = 'block';
            placeholder.style.display = 'none';

            preview.onerror = function() {
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                placeholder.innerHTML = '<i class="bi bi-exclamation-triangle text-danger display-4 d-block mb-2"></i><span class="text-danger small">Geçersiz Resim URL</span>';
            };
        } else {
            preview.style.display = 'none';
            placeholder.style.display = 'block';
        }
    }

    // Başlıktan Slug Üretme Scripti
    function generateSlug(text) {
        var slug = text.toString().toLowerCase()
            .replace(/\s+/g, '-')           // Boşlukları - yap
            .replace(/[^\w\-]+/g, '')       // Alfanümerik olmayanları sil
            .replace(/\-\-+/g, '-')         // Çift -'leri tek yap
            .replace(/^-+/, '')             // Başındaki -'leri sil
            .replace(/-+$/, '');            // Sonundaki -'leri sil

        document.getElementById('projectSlug').value = slug;
    }
</script>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
</style>