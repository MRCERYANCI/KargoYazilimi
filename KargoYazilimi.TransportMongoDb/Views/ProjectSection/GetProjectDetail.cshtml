@model GetProjectSectionBySlugDto

@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")

    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")

    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <main class="main" style="background-color: #f4f7fa;">
        <section class="section pt-80 pb-80" style="background: #05264e; border-bottom: 4px solid #0d6efd;">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="d-flex align-items-center mb-20">
                            <span class="badge bg-primary px-3 py-2 me-3">@Model.Category</span>
                            <div style="width: 50px; height: 2px; background: rgba(255,255,255,0.3);"></div>
                        </div>
                        <h1 class="color-white display-5 fw-bold">@Model.Title</h1>
                    </div>
                </div>
            </div>
        </section>

        <section class="section pt-60 pb-80">
            <div class="container">
                <div class="row">
                    <div class="col-lg-8">

                        <div class="mb-40 shadow-lg" style="border-radius: 20px; overflow: hidden; line-height: 0;">
                            <img src="@Model.ImageUrl" alt="@Model.Title" style="width: 100%; height: auto; max-height: 500px; object-fit: cover;">
                        </div>

                        <div class="project-content-wrapper">
                            <div class="project-body-content">
                                @Html.Raw(Model.FullDescription)
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="sticky-top" style="top: 100px;">

                            <div class="card border-0 shadow-sm p-4 mb-30" style="border-radius: 15px; background: #ffffff;">
                                <h5 class="fw-bold mb-20 text-dark border-bottom pb-2">Proje Bilgileri</h5>

                                <ul class="list-unstyled">
                                    <li class="d-flex mb-3">
                                        <i class="bi bi-check-circle-fill text-primary me-2"></i>
                                        <div>
                                            <small class="text-muted d-block">Hizmet</small>
                                            <strong>@Model.Category</strong>
                                        </div>
                                    </li>
                                    <li class="d-flex mb-3">
                                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                        <div>
                                            <small class="text-muted d-block">Lokasyon</small>
                                            <strong>Kayseri / Uluslararası</strong>
                                        </div>
                                    </li>
                                    <li class="d-flex">
                                        <i class="bi bi-shield-fill-check text-success me-2"></i>
                                        <div>
                                            <small class="text-muted d-block">Durum</small>
                                            <strong class="text-success">Tamamlandı</strong>
                                        </div>
                                    </li>
                                </ul>
                            </div>

                            <div class="p-4 rounded-4 shadow-lg text-center" style="background: #0d6efd;">
                                <h5 class="text-white mb-3">Lojistik Çözümü Gerekiyor mu?</h5>
                                <p class="text-white-50 small mb-4">Sizin için en uygun operasyon planını hazırlayalım.</p>
                                <a href="/Contact/Index" class="btn btn-light w-100 fw-bold py-3 rounded-pill">
                                    Bize Ulaşın
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <style>
        /* DİKKAT: Editörden gelen stillerin bozulmaması için
               temel bootstrap resetlerini bu div içinde eziyoruz.
            */
        .project-body-content {
            background: transparent; /* Arka planı transparan yaptık */
            padding: 0;
            color: #333;
            font-size: 1.15rem;
            line-height: 1.7;
        }

            /* Editörden gelen resimlerin taşmasını önle */
            .project-body-content img {
                max-width: 100% !important;
                height: auto !important;
                border-radius: 10px;
                margin: 15px 0;
            }

            /* Başlıkların stilini netleştir */
            .project-body-content h1, .project-body-content h2, .project-body-content h3 {
                color: #05264e;
                margin-top: 1.5em;
                margin-bottom: 0.8em;
                font-weight: 700;
            }

            /* Tablo gelirse tasarımı koru */
            .project-body-content table {
                width: 100% !important;
                background: white;
                border-radius: 8px;
                overflow: hidden;
                margin: 20px 0;
                border-collapse: collapse;
            }

                .project-body-content table td, .project-body-content table th {
                    padding: 12px;
                    border: 1px solid #dee2e6;
                }

            .project-body-content blockquote {
                border-left: 5px solid #0d6efd;
                padding-left: 20px;
                font-style: italic;
                color: #555;
                margin: 25px 0;
            }
    </style>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")

    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>