@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "TestimonialList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-chat-left-quote-fill me-2 text-primary"></i>Müşteri Yorumları & Referans Yönetimi
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Referans Tablosu</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 border-radius-15">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">Referans Listesi</h5>
                <a href="/Testimonial/CreateTestimonial" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Yorum Ekle
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Müşteri</th>
                                <th>Yorum Özeti</th>
                                <th class="text-center">Puan / Yıldız</th>
                                <th class="text-center">Durum</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td><span class="fw-bold">@count</span></td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="user" class="rounded-circle border shadow-sm me-3" style="width: 45px; height: 45px; object-fit: cover;">
                                                <div class="d-flex flex-column">
                                                    <span class="fw-bold text-dark">@item.FullName</span>
                                                    <small class="text-muted text-truncate" style="max-width: 150px;">@item.Title</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <p class="mb-0 text-muted small text-truncate" style="max-width: 300px;" title="@item.Comment">
                                                "@item.Comment"
                                            </p>
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex flex-column align-items-center">
                                                <div class="text-warning mb-1">
                                                    @for (int i = 0; i < item.StarCount; i++)
                                                    {
                                                        <i class="bi bi-star-fill fs-12"></i>
                                                    }
                                                </div>
                                                <span class="badge bg-light text-dark border">@item.RatingScore / 5</span>
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2">Yayında</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2">Taslak</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group shadow-sm">
                                                <a href="/Testimonial/UpdateTestimonial/@item.TestimonialId" class="btn btn-outline-warning btn-sm border-0" title="Düzenle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <button onclick="deleteTestimonial('@item.TestimonialId')" class="btn btn-outline-danger btn-sm border-0" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5">
                                        <i class="bi bi-chat-quote display-4 text-muted d-block mb-3"></i>
                                        Henüz bir müşteri yorumu eklenmemiş.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-radius-15 {
        border-radius: 15px;
    }

    .custom-table thead th {
        border-top: none;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 15px;
    }

    .fs-12 {
        font-size: 12px;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }

    .bg-danger-subtle {
        background-color: #fee2e2 !important;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
        transition: 0.2s;
    }
</style>

<script>
    function deleteTestimonial(id) {
        if (confirm("Bu müşteri yorumunu silmek istediğinizden emin misiniz?")) {
            window.location.href = "/Testimonial/DeleteTestimonial/" + id;
        }
    }
</script>