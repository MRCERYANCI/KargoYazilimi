@model GetTestimonialByIdDto

@{
    ViewData["Title"] = "UpdateTestimonial";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<br />
<br />
<div class="row justify-content-center">
    <div class="col-xl-12">
        <div class="card shadow-lg border-0" style="border-radius: 15px;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-pencil-square me-2 text-warning"></i>Müşteri Yorumunu Güncelle
                </h5>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    @* MongoDB ID'sini kaybetmemek için gizli alan *@
                    <input type="hidden" asp-for="TestimonialId" />

                    <div class="row">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Müşteri Adı Soyadı</label>
                                <input type="text" asp-for="FullName" class="form-control rounded-3" placeholder="Örn: Ahmet Yılmaz" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Müşteri Ünvanı / Departmanı</label>
                                <input type="text" asp-for="Title" class="form-control rounded-3" placeholder="Örn: Lojistik Müdürü" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Profil Fotoğrafı URL</label>
                                <input type="text" asp-for="ImageUrl" id="testimonialImageUrl" class="form-control rounded-3" placeholder="https://.../resim.jpg" oninput="previewImage(this)">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Müşteri Yorumu</label>
                                <textarea asp-for="Comment" class="form-control rounded-3" rows="4" placeholder="Hizmet hakkındaki düşünceler..."></textarea>
                            </div>
                        </div>

                        <div class="col-md-5 border-start ps-4">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold text-warning"><i class="bi bi-star-fill me-1"></i>Yıldız Sayısı</label>
                                    <select asp-for="StarCount" class="form-select rounded-3">
                                        <option value="5">5 Yıldız</option>
                                        <option value="4">4 Yıldız</option>
                                        <option value="3">3 Yıldız</option>
                                        <option value="2">2 Yıldız</option>
                                        <option value="1">1 Yıldız</option>
                                    </select>
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label fw-bold">Puan (0-5.00)</label>
                                    <input type="text" asp-for="RatingScore" class="form-control rounded-3" placeholder="4.95">
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-bold">Sıralama (OrderNo)</label>
                                <input type="number" asp-for="OrderNo" class="form-control rounded-3">
                            </div>

                            <div class="text-center p-3 border rounded-3 bg-light">
                                <label class="form-label d-block text-start small fw-bold text-muted">Mevcut / Yeni Fotoğraf</label>
                                <img id="imagePreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/templates/assets/imgs/page/homepage1/author.png" : Model.ImageUrl)"
                                     class="rounded-circle border shadow-sm mb-2"
                                     style="width: 100px; height: 100px; object-fit: cover;">
                            </div>

                            <div class="form-check form-switch mt-4 p-3 border rounded-3 bg-white">
                                <label class="form-check-label fw-bold" for="IsActive">Yorum Yayında mı?</label>
                                <input class="form-check-input float-end" type="checkbox" asp-for="IsActive" style="width: 2.5em; height: 1.25em;">
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4">
                        <a href="/Admin/Testimonial/Index" class="btn btn-light px-4 rounded-pill me-2">Vazgeç</a>
                        <button type="submit" class="btn btn-warning px-5 rounded-pill shadow-sm fw-bold text-dark">
                            <i class="bi bi-arrow-repeat me-1"></i> Değişiklikleri Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewImage(input) {
        var preview = document.getElementById('imagePreview');
        if (input.value && input.value.trim() !== "") {
            preview.src = input.value;
            preview.onerror = function() {
                preview.src = "/templates/assets/imgs/page/homepage1/author.png";
            };
        } else {
            preview.src = "/templates/assets/imgs/page/homepage1/author.png";
        }
    }
</script>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 0.25rem rgba(255, 193, 7, 0.1);
    }

    label {
        font-size: 14px;
    }
</style>