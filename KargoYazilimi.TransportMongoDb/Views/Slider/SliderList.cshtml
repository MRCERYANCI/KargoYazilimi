@model List<ResultSliderDto>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@{
    ViewData["Title"] = "Slider Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-images me-2 text-primary"></i>Slider Görsel Yönetimi
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Slider Tablosu</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h5 class="card-title mb-0 text-secondary">
                    <span class="badge bg-primary-subtle text-primary rounded-pill me-2">@Model.Count()</span> Kayıtlı İçerik
                </h5>
                <a href="/Slider/CreateSlider" class="btn btn-sm btn-primary px-3 rounded-2 shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Yeni Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase fs-13">
                                <th class="ps-4 text-muted fw-bold" style="width: 70px;">Sıra</th>
                                <th class="text-muted fw-bold">Önizleme</th>
                                <th class="text-muted fw-bold">İçerik Bilgisi</th>
                                <th class="text-muted fw-bold text-center">Durum</th>
                                <th class="text-muted fw-bold text-end pe-4">Yönetim</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderBy(x => x.OrderNo))
                            {
                                <tr class="transition-all">
                                    <td class="ps-4">
                                        <div class="fw-bold fs-15 text-primary">#@item.OrderNo</div>
                                    </td>
                                    <td>
                                        <div class="position-relative overflow-hidden rounded-3 shadow-sm" style="width: 110px; height: 65px; border: 1px solid #eee;">
                                            <img src="@item.ImageUrl" class="w-100 h-100 object-fit-cover"
                                                 onerror="this.src='https://placehold.co/200x120?text=Resim+Yok'">
                                            @if (!string.IsNullOrEmpty(item.VideoUrl))
                                            {
                                                <div class="position-absolute top-50 start-50 translate-middle">
                                                    <i class="bi bi-play-circle-fill text-white fs-4 opacity-75"></i>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark fs-14 mb-0">@Html.Raw(item.MainTitle)</span>
                                            <span class="text-muted small"><i class="bi bi-type-h1 me-1"></i>@item.SmallTitle</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-2 fw-semibold">
                                                <i class="bi bi-broadcast me-1"></i> Yayında
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary px-3 py-2 rounded-2 fw-semibold">
                                                <i class="bi bi-eye-slash me-1"></i> Gizli
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group">
                                            <a href="/Slider/UpdateSlider/@item.SliderId" class="btn btn-sm btn-outline-secondary border-0" title="Düzenle">
                                                <i class="bi bi-pencil-square fs-5"></i>
                                            </a>
                                            <a href="/Slider/DeleteSlider/@item.SliderId" class="btn btn-sm btn-outline-danger border-0"
                                               onclick="return confirm('Bu slider kaydını silmek istediğinize emin misiniz?')" title="Sil">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Tasarımın "Premium" hissettirmesi için küçük dokunuşlar */
    .table-hover tbody tr:hover {
        background-color: #f8faff !important;
        transform: scale(1.002);
    }

    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .bg-primary-subtle {
        background-color: #e0e7ff !important;
    }

    .bg-success-subtle {
        background-color: #dcfce7 !important;
    }

    .object-fit-cover {
        object-fit: cover;
    }

    .fs-13 {
        font-size: 0.85rem;
    }

    .fs-14 {
        font-size: 0.95rem;
    }

    .fs-15 {
        font-size: 1.1rem;
    }

    /* Scrollbar tasarımı (Tablo çok genişlerse) */
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: #cbd5e0;
        border-radius: 10px;
    }
</style>