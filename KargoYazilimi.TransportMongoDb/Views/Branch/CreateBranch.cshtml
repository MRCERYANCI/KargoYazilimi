@model CreateBranchDto

@{
    ViewData["Title"] = "CreateBranch";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-geo-alt-fill me-2 text-primary"></i>Şube Yönetimi
        </h4>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-primary">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Şube Tanımlama Alanı
                </h5>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="Latitude" id="LatInput" />
                    <input type="hidden" asp-for="Longitude" id="LngInput" />

                    <div class="row g-4">
                        <div class="col-lg-6">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Şube Adı</label>
                                    <input type="text" asp-for="BranchName" class="form-control" placeholder="Örn: Kayseri Melikgazi" required>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Şube Kodu</label>
                                    <input type="text" asp-for="BranchCode" class="form-control" placeholder="KY-MLK-01" required>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">Şehir</label>
                                    <input type="text" asp-for="City" class="form-control" value="Kayseri">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold">İlçe</label>
                                    <input type="text" asp-for="District" class="form-control" placeholder="Melikgazi">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">İletişim Numarası</label>
                                <input type="text" asp-for="Phone" class="form-control" placeholder="0352 XXX XX XX">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Şube Müdürü</label>
                                <input type="text" asp-for="ManagerName" class="form-control" placeholder="Ad Soyad">
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Tam Adres</label>
                                <textarea asp-for="FullAddress" class="form-control" rows="3" placeholder="Şubenin açık adresini giriniz..."></textarea>
                            </div>

                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" asp-for="IsActive" checked>
                                <label class="form-check-label fw-bold">Şube Aktif mi?</label>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <label class="form-label fw-bold text-primary">
                                <i class="bi bi-map me-1"></i> Konum Seçimi (Tıklayarak İşaretleyin)
                            </label>
                            <div id="branchMap" class="rounded-3 border shadow-sm" style="height: 450px; width: 100%;"></div>
                            <div class="mt-2 text-muted small">
                                <i class="bi bi-info-circle me-1"></i> Harita üzerinde şubenin yerini tıkladığınızda iğne yerleşecek ve koordinatlar kaydedilecektir.
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4 pt-3 border-top">
                        <a href="/Admin/Branch/Index" class="btn btn-light px-4 rounded-pill me-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm">
                            <i class="bi bi-save me-1"></i> Şubeyi Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Haritayı Başlat
    var map = L.map('branchMap').setView([38.7205, 35.4826], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
    var marker;

    // 2. Haritaya Tıklama Olayı
    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        // İğneyi Güncelle
        if (marker) { map.removeLayer(marker); }
        marker = L.marker([lat, lng]).addTo(map).bindPopup("Konum Belirleniyor...").openPopup();

        // Koordinatları Yaz
        document.getElementById('LatInput').value = lat;
        document.getElementById('LngInput').value = lng;

        // --- ADRES BİLGİSİNİ ÇEK (Reverse Geocoding) ---
        fetch(`https://nominatim.openstreetmap.org/reverse?format=jsonv2&lat=${lat}&lon=${lng}`)
            .then(response => response.json())
            .then(data => {
                if (data.address) {
                    const addr = data.address;

                    // İlçe Bilgisi (Town, District veya Suburb olarak gelebilir)
                    const district = addr.district || addr.town || addr.suburb || addr.city_district || "";
                    // Şehir Bilgisi
                    const city = addr.province || addr.city || "";
                    // Tam Adres Metni
                    const displayName = data.display_name;

                    // Form Alanlarını Doldur
                    document.querySelector('input[name="City"]').value = city;
                    document.querySelector('input[name="District"]').value = district;
                    document.querySelector('textarea[name="FullAddress"]').value = displayName;

                    marker.setPopupContent("<b>Adres Onaylandı:</b><br>" + district).openPopup();
                }
            })
            .catch(error => {
                console.error('Adres çekilemedi:', error);
                marker.setPopupContent("Koordinat seçildi ama adres bulunamadı.").openPopup();
            });
    });
</script>

<style>
    #branchMap {
        cursor: crosshair;
    }

    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }
</style>