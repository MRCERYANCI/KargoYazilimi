@model List<ResultBrandDto>

@{
    ViewData["Title"] = "Marka Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-patch-check-fill me-2 text-primary"></i>Marka & Referans Yönetimi
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Marka Tablosu</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
                <h5 class="card-title mb-0 text-secondary">
                    <span class="badge bg-primary-subtle text-primary rounded-pill me-2">@Model.Count()</span> Kayıtlı Marka
                </h5>
                <a href="/Brand/CreateBrand" class="btn btn-sm btn-success px-3 rounded-2 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Marka Ekle
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-uppercase fs-13">
                                <th class="ps-4 text-muted fw-bold" style="width: 80px;">Sıra</th>
                                <th class="text-muted fw-bold">Logo</th>
                                <th class="text-muted fw-bold">Marka Adı</th>
                                <th class="text-muted fw-bold text-center">Durum</th>
                                <th class="text-muted fw-bold text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderBy(x => x.OrderNo))
                            {
                                <tr class="transition-all">
                                    <td class="ps-4">
                                        <div class="fw-bold fs-15 text-primary">#@item.OrderNo</div>
                                    </td>
                                    <td>
                                        <div class="bg-light rounded-3 d-flex align-items-center justify-content-center border shadow-sm"
                                             style="width: 80px; height: 50px; overflow: hidden; background-image: radial-gradient(#e1e1e1 1px, transparent 1px); background-size: 10px 10px;">
                                            <img src="@item.ImageUrl" class="p-1" style="max-width: 100%; max-height: 100%; object-fit: contain;"
                                                 onerror="this.src='https://placehold.co/100x60?text=No+Logo'">
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark fs-14">@item.BrandName</span>
                                            <small class="text-muted italic">@item.WebsiteUrl</small>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success-subtle text-success px-3 py-2 rounded-2 fw-semibold border border-success-subtle">
                                                <i class="bi bi-check-circle-fill me-1"></i> Yayında
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary px-3 py-2 rounded-2 fw-semibold border">
                                                <i class="bi bi-pause-fill me-1"></i> Gizli
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-2 overflow-hidden">
                                            <a href="/Brand/UpdateBrand/@item.BrandId" class="btn btn-sm btn-white border-end" title="Düzenle">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <a href="/Brand/DeleteBrand/@item.BrandId" class="btn btn-sm btn-white text-danger"
                                               onclick="return confirm('Bu markayı listeden çıkarmak istediğinize emin misiniz?')" title="Sil">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-building-exclamation display-3 text-light"></i>
                    <p class="text-muted mt-2">Henüz hiçbir marka/referans eklenmemiş.</p>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8faff !important;
        transition: 0.2s ease-in-out;
    }

    .bg-success-subtle {
        background-color: #e6fffa !important;
    }

    .bg-primary-subtle {
        background-color: #eef2ff !important;
    }

    .btn-white {
        background: #fff;
    }

        .btn-white:hover {
            background: #f8f9fa;
        }

    .fs-13 {
        font-size: 0.8rem;
    }

    .fs-14 {
        font-size: 0.95rem;
    }

    .fs-15 {
        font-size: 1.05rem;
    }
</style>