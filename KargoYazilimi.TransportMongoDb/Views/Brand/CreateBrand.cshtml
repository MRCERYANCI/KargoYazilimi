@model CreateBrandDto

@{
    ViewData["Title"] = "CreateBrand";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<br /><br />
<div class="row">
    <div class="col-xl-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-primary">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Brand Ekleme Alanı
                </h5>
            </div>

            <form method="post" class="mt-2">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="row g-3">
                                <div class="col-md-12">
                                    <label class="form-label fw-semibold text-secondary">Marka Adı</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-tag"></i></span>
                                        <input type="text" asp-for="BrandName" class="form-control form-control-lg" placeholder="Örn: Trendyol, Hepsiburada..." required>
                                    </div>
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-semibold text-secondary">Sıralama (OrderNo)</label>
                                    <input type="number" asp-for="OrderNo" class="form-control" value="1" required>
                                    <div class="form-text">Logonun kaçıncı sırada görüneceğini belirler.</div>
                                </div>

                                <div class="col-md-6 mt-4">
                                    <label class="form-label fw-semibold text-secondary">Web Sitesi (Opsiyonel)</label>
                                    <input type="text" asp-for="WebsiteUrl" class="form-control" placeholder="https://www.marka.com">
                                </div>

                                <div class="col-md-12 mt-4">
                                    <label class="form-label fw-semibold text-secondary">Logo Görsel URL</label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light"><i class="bi bi-link-45deg"></i></span>
                                        <input type="text" asp-for="ImageUrl" id="brandImageUrl" class="form-control" placeholder="https://.../logo.png" oninput="previewBrandLogo(this)" required>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-5 border-start ps-4 text-center">
                            <label class="form-label fw-semibold text-secondary d-block text-start">Logo Önizleme</label>
                            <div class="brand-preview-box rounded-3 shadow-sm mb-3 d-flex align-items-center justify-content-center bg-light border"
                                 style="width: 100%; height: 180px; overflow: hidden; background-image: radial-gradient(#d1d1d1 1px, transparent 1px); background-size: 20px 20px;">
                                <img id="brandPreview" src="#" alt="Logo Önizleme" style="display: none; max-width: 80%; max-height: 80%; object-fit: contain;">
                                <div id="brandPlaceholder" class="text-muted">
                                    <i class="bi bi-building-up display-4 d-block mb-2"></i>
                                    <span class="small">Logo URL'si girin</span>
                                </div>
                            </div>

                            <div class="p-3 rounded-3 border bg-white mt-4">
                                <div class="form-check form-switch d-flex justify-content-between align-items-center p-0">
                                    <label class="form-check-label fw-bold mb-0" for="IsActive">Marka Aktif mi?</label>
                                    <input class="form-check-input ms-0" type="checkbox" asp-for="IsActive" id="IsActive" checked value="true" style="width: 2.5em; height: 1.25em;">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top py-4 px-4 text-end">
                    <button type="reset" class="btn btn-outline-secondary px-4 me-2">İptal</button>
                    <button type="submit" class="btn btn-primary px-5 fw-bold shadow-sm">
                        <i class="bi bi-check2-circle me-2"></i> Markayı Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


<script>
    function previewBrandLogo(input) {
        var preview = document.getElementById('brandPreview');
        var placeholder = document.getElementById('brandPlaceholder');

        if (input.value && input.value.trim() !== "") {
            preview.src = input.value;
            preview.style.display = 'block';
            placeholder.style.display = 'none';

            preview.onerror = function() {
                preview.style.display = 'none';
                placeholder.style.display = 'block';
                placeholder.innerHTML = '<i class="bi bi-exclamation-triangle text-danger display-4 d-block mb-2"></i><span class="text-danger small">Hatalı Resim URL</span>';
            };
        } else {
            preview.style.display = 'none';
            placeholder.style.display = 'block';
            placeholder.innerHTML = '<i class="bi bi-building-up display-4 d-block mb-2"></i><span class="small">Logo URL\'si girin</span>';
        }
    }
</script>
