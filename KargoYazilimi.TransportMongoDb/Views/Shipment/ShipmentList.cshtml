@model List<ResultShipmentDto>
@using static KargoYazilimi.TransportMongoDb.Entities.Enums

@{
    ViewData["Title"] = "Kargo Listesi";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@functions {
    public string GetStatusText(ShipmentStatus status)
    {
        switch (status)
        {
            case ShipmentStatus.Created: return "Kabul Edildi";
            case ShipmentStatus.InTransit: return "Transferde";
            case ShipmentStatus.ArrivedAtBranch: return "Varış Şubesinde";
            case ShipmentStatus.OutForDelivery: return "Dağıtıma Çıktı";
            case ShipmentStatus.Delivered: return "Teslim Edildi";
            case ShipmentStatus.FailedAttempt: return "Teslim Edilemedi";
            case ShipmentStatus.Canceled: return "İptal Edildi";
            case ShipmentStatus.Returned: return "İade Edildi";
            default: return status.ToString();
        }
    }

    public string GetStatusBadgeClass(ShipmentStatus status)
    {
        switch (status)
        {
            case ShipmentStatus.Delivered: return "bg-success-subtle text-success border-success-subtle";
            case ShipmentStatus.OutForDelivery: return "bg-warning-subtle text-warning border-warning-subtle";
            case ShipmentStatus.FailedAttempt:
            case ShipmentStatus.Canceled:
            case ShipmentStatus.Returned: return "bg-danger-subtle text-danger border-danger-subtle";
            case ShipmentStatus.ArrivedAtBranch: return "bg-info-subtle text-info border-info-subtle"; // Şubede için turkuaz renk
            default: return "bg-primary-subtle text-primary border-primary-subtle";
        }
    }

    public string GetStatusIcon(ShipmentStatus status)
    {
        switch (status)
        {
            case ShipmentStatus.Delivered: return "bi-check-circle-fill";
            case ShipmentStatus.OutForDelivery: return "bi-truck";
            case ShipmentStatus.InTransit: return "bi-signpost-split-fill";
            case ShipmentStatus.ArrivedAtBranch: return "bi-shop"; // Şube ikonu eklendi
            case ShipmentStatus.FailedAttempt: return "bi-exclamation-triangle-fill";
            default: return "bi-box-seam";
        }
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-box-seam-fill me-2 text-primary"></i>Kargo Operasyon Yönetimi
        </h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Kargo Tablosu</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-xl-12">
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom flex-wrap gap-3">
                <h5 class="card-title mb-0 text-secondary">
                    <span class="badge bg-primary-subtle text-primary rounded-pill me-2">@Model.Count()</span> Kayıtlı Kargo
                </h5>

                <!-- BARKOD ARAMA ÇUBUĞU -->
                <div class="input-group" style="max-width: 300px;">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control border-start-0 bg-light" placeholder="Takip No ile ara (CJET-...)" onkeyup="filterTable()">
                </div>

                <a href="/Admin/Shipment/CreateShipment" class="btn btn-sm btn-success px-3 rounded-2 shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Kargo Girişi
                </a>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="shipmentTable">
                        <thead class="table-light">
                            <tr class="text-uppercase fs-13">
                                <th class="ps-4 text-muted fw-bold">Tarih / Saat</th>
                                <th class="text-muted fw-bold">Takip No (Barkod)</th>
                                <th class="text-muted fw-bold">Gönderici / Alıcı</th>
                                <th class="text-muted fw-bold text-center">Durum</th>
                                <th class="text-muted fw-bold text-end pe-4">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderByDescending(x => x.CreatedDate))
                            {
                                <tr class="transition-all">
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark fs-14">@item.CreatedDate.ToString("dd.MM.yyyy")</div>
                                        <small class="text-muted">@item.CreatedDate.ToString("HH:mm")</small>
                                    </td>
                                    <td>
                                        <div class="bg-light d-inline-block px-2 py-1 rounded border shadow-sm fw-bold text-primary" style="font-family: monospace; letter-spacing: 1px;">
                                            <i class="bi bi-upc-scan me-1"></i> @item.TrackingNumber
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="fw-bold text-dark fs-14"><i class="bi bi-arrow-up-right text-secondary me-1"></i>@item.SenderName</span>
                                            <span class="fw-bold text-dark fs-14"><i class="bi bi-arrow-down-right text-success me-1"></i>@item.ReceiverName</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <!-- TÜRKÇE VE DİNAMİK RENKLİ DURUM ALANI -->
                                        <span class="badge px-3 py-2 rounded-2 fw-semibold border @GetStatusBadgeClass(item.CurrentStatus)">
                                            <i class="bi @GetStatusIcon(item.CurrentStatus) me-1"></i> @GetStatusText(item.CurrentStatus)
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm rounded-2 overflow-hidden">

                                            <!-- 1. BARKOD YAZDIR BUTONU (POPUP AÇAR) -->
                                            <button type="button" onclick="openPrintModal('@item.ShipmentId')" class="btn btn-sm btn-dark border-end" title="Barkod Yazdır">
                                                <i class="bi bi-printer-fill text-white"></i>
                                            </button>

                                            <!-- 2. HAREKET (KONUM) EKLE BUTONU -->
                                            <a href="/AddMovement/@item.ShipmentId" class="btn btn-sm btn-warning border-end" title="Hareket / Konum Ekle">
                                                <i class="bi bi-geo-alt-fill text-dark"></i>
                                            </a>

                                            <a href="/Admin/Shipment/ShipmentDetail/@item.ShipmentId" class="btn btn-sm btn-white border-end" title="Detaylar">
                                                <i class="bi bi-eye-fill text-info"></i>
                                            </a>
                                            <a href="/Admin/Shipment/UpdateShipment/@item.ShipmentId" class="btn btn-sm btn-white border-end" title="Düzenle">
                                                <i class="bi bi-pencil-fill text-primary"></i>
                                            </a>
                                            <a href="/Admin/Shipment/DeleteShipment/@item.ShipmentId" class="btn btn-sm btn-white text-danger" onclick="return confirm('Bu kargoyu silmek istediğinize emin misiniz?')" title="Sil">
                                                <i class="bi bi-trash3-fill"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-3 text-light"></i>
                    <p class="text-muted mt-2">Henüz hiçbir kargo kaydı bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- BARKOD YAZDIRMA POPUP'I (MODAL) -->
<div class="modal fade" id="barcodeModal" tabindex="-1" aria-labelledby="barcodeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header bg-dark text-white border-0 py-3">
                <h5 class="modal-title fs-15 fw-bold" id="barcodeModalLabel"><i class="bi bi-upc-scan me-2"></i>Termal Barkod Önizleme</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>

            <!-- Etiketin yükleneceği izole iframe alanı -->
            <div class="modal-body p-0" style="background-color: #e2e8f0; height: 420px;">
                <iframe id="barcodeIframe" src="" style="width: 100%; height: 100%; border: none;"></iframe>
            </div>

            <div class="modal-footer bg-light border-0 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary fw-bold px-4" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-primary fw-bold px-4 shadow-sm" onclick="printBarcodeFromIframe()">
                    <i class="bi bi-printer-fill me-2"></i>Yazıcıya Gönder
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f8faff !important;
        transition: 0.2s ease-in-out;
    }

    .bg-success-subtle {
        background-color: #e6fffa !important;
    }

    .bg-primary-subtle {
        background-color: #eef2ff !important;
    }

    .bg-warning-subtle {
        background-color: #fff8e6 !important;
        color: #b7791f !important;
    }

    .bg-danger-subtle {
        background-color: #fff5f5 !important;
    }

    .border-danger-subtle {
        border-color: #fecaca !important;
    }

    .btn-white {
        background: #fff;
    }

        .btn-white:hover {
            background: #f8f9fa;
        }

    .fs-13 {
        font-size: 0.8rem;
    }

    .fs-14 {
        font-size: 0.95rem;
    }
</style>

<!-- JAVASCRIPT KODLARI: ARAMA VE YAZDIRMA -->
<script>
    // Tabloda Barkod araması yapar
    function filterTable() {
        var input, filter, table, tr, td, i, txtValue;
        input = document.getElementById("searchInput");
        filter = input.value.toUpperCase();
        table = document.getElementById("shipmentTable");
        tr = table.getElementsByTagName("tr");

        for (i = 1; i < tr.length; i++) {
            td = tr[i].getElementsByTagName("td")[1]; // 2. Sütun (Takip No)
            if (td) {
                txtValue = td.textContent || td.innerText;
                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                    tr[i].style.display = "";
                } else {
                    tr[i].style.display = "none";
                }
            }
        }
    }

    // Modal'ı açıp Iframe içine barkodu yükler
    function openPrintModal(shipmentId) {
        // İFRAME URL YOLU DÜZELTİLDİ: Controller yapına uygun olarak
        document.getElementById('barcodeIframe').src = '/PrintBarcode/' + shipmentId;
        var myModal = new bootstrap.Modal(document.getElementById('barcodeModal'));
        myModal.show();
    }

    // Iframe içindeki sayfayı (termal etiketi) yazdırır
    function printBarcodeFromIframe() {
        var iframe = document.getElementById('barcodeIframe');
        iframe.contentWindow.focus();
        iframe.contentWindow.print();
    }
</script>