@model GetShipmentByIdDto
@{
    Layout = null; // Termal baskıda menü veya footer olmasın diye Layout'u kapattık
}

<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>@Model.TrackingNumber - Termal Etiket</title>
<style>
    @@Spage { margin: 0; size: auto; }
    body { background-color: #fff; color: #000; font-family: Arial, sans-serif; margin: 0; padding: 20px; display: flex; justify-content: center; }
    .thermal-label { width: 380px; background: #fff; border: 2px solid #000; padding: 5px; box-sizing: border-box; }
    
    .header-section { display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #000; padding-bottom: 5px; margin-bottom: 5px; }
    .header-qr { width: 60px; height: 60px; }
    .header-center { flex: 1; text-align: center; display: flex; flex-direction: column; justify-content: flex-end; padding: 0 5px; }
    .route-text { font-size: 24px; font-weight: bold; letter-spacing: -0.5px; margin-bottom: 2px; text-transform: uppercase;}
    .date-bar { background: #000; color: #fff; width: 100%; display: flex; justify-content: space-between; padding: 2px 4px; font-size: 10px; font-weight: bold; box-sizing: border-box; }
    
    .header-right { text-align: center; }
    .hub-code { border: 2px solid #000; font-size: 24px; font-weight: bold; padding: 2px 6px; }
    .hub-id { font-size: 10px; font-weight: bold; margin-top: 2px; }
    
    .body-section { display: flex; }
    .left-col { flex: 1; border-right: 2px solid #000; padding-right: 5px; display: flex; flex-direction: column; }
    .data-row { border-bottom: 1px solid #000; padding: 3px 0; }
    .data-row:last-child { border-bottom: none; padding-bottom: 0; }
    
    .flex-row { display: flex; justify-content: space-between; align-items: flex-start; }
    .label-sm { font-size: 9px; font-weight: bold; text-transform: uppercase; display: block; }
    .val-md { font-size: 14px; font-weight: bold; display: block; text-transform: uppercase;}
    .val-lg { font-size: 19px; font-weight: bold; display: block; letter-spacing: -0.5px; text-transform: uppercase;}
    
    .black-banner { background: #000; color: #fff; text-align: center; font-size: 22px; font-weight: bold; padding: 4px 0; margin: 4px 0; text-transform: uppercase; }
    
    .brand-logo { font-size: 16px; text-align: right; }
    .brand-c { font-weight: 800; }
    .brand-j { font-weight: 900; font-style: italic; }
    
    .right-col { width: 80px; display: flex; flex-direction: column; align-items: center; padding-left: 5px; }
    .vertical-container { display: flex; justify-content: space-between; align-items: center; height: 180px; width: 100%; margin-bottom: 5px; }
    .v-text { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 11px; font-weight: bold; }
    
    .v-barcode-placeholder {
        height: 100%; width: 35px;
        background: repeating-linear-gradient(to bottom, #000 0, #000 2px, #fff 2px, #fff 4px, #000 4px, #000 7px, #fff 7px, #fff 8px, #000 8px, #000 12px, #fff 12px, #fff 15px);
    }
    
    .qr-bottom { width: 55px; height: 55px; margin-top: auto; }
    .btn-print { position: fixed; top: 20px; left: 20px; background: #000; color: #fff; padding: 10px 20px; border: none; font-weight: bold; cursor: pointer; }
    
    @@media print {
        .btn-print { display: none; }
        body { padding: 0; }
        .thermal-label { border: none; padding: 0; }
        * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }
    }
</style>
</head>
<body>


<div class="thermal-label">
    
    <div class="header-section">
        <!-- Takip numarasına göre Dinamik Üst QR -->
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@Model.TrackingNumber" class="header-qr" alt="QR">
        
        <div class="header-center">
            <div class="route-text">@Model.SenderCity (İç)</div>
            <div class="date-bar">
                <span>@Model.PackageCount/@Model.PackageCount</span>
                <span>@Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
        </div>
        
        <div class="header-right">
            <div class="hub-code">JET</div>
            <div class="hub-id">TR</div>
        </div>
    </div>

    <div class="body-section">
        <div class="left-col">
            
            <div class="data-row flex-row">
                <div>
                    <span class="label-sm">VARIŞ İLİ:</span>
                    <span class="val-md">@Model.ReceiverCity</span>
                    <span class="label-sm" style="margin-top:4px;">VARIŞ İLÇESİ:</span>
                    <span class="val-md">@Model.ReceiverDistrict</span>
                </div>
                <div class="brand-logo">
                    <span class="brand-c">Çokkeçeci</span><span class="brand-j">JET</span>
                </div>
            </div>

            <div class="data-row flex-row" style="align-items: flex-end;">
                <div>
                    <span class="label-sm">VARIŞ MAHALLESİ:</span>
                    <span class="val-lg">@Model.ReceiverNeighborhood</span>
                </div>
                <div style="font-size:12px; font-weight:bold;">@Model.TrackingNumber</div>
            </div>

            <div class="data-row" style="padding:0; border-bottom:none;">
                <div class="black-banner">@Model.ReceiverDistrict</div>
            </div>

            <div class="data-row">
                <span class="label-sm">ÇALIŞMA ALANI:</span>
                <span class="val-md">KCRN1 - STD.@Model.TotalDesi</span>
            </div>

            <div class="data-row">
                <span class="label-sm" style="display:inline;">ÇIKIŞ:</span> 
                <span class="val-md" style="display:inline; font-size:12px;">@Model.OriginBranchName</span>
            </div>

            <div class="data-row flex-row">
                <span class="val-md" style="font-size:12px;">@Model.PackageType Teslimat</span>
                <span class="val-md" style="font-size:12px;">@DateTime.Now.AddDays(2).ToString("dd.MM.yyyy") / --</span>
            </div>

            <div class="data-row">
                <span class="label-sm" style="display:inline;">GÖNDERİCİ:</span> 
                <span class="val-md" style="display:inline; font-size:12px;">@Model.SenderName</span>
            </div>

            <div class="data-row" style="min-height: 40px;">
                <span class="label-sm">ALICI: @Model.ReceiverName</span>
                <span class="label-sm" style="margin-top:5px; font-weight: normal;">ADRES: @Model.ReceiverAddress</span>
            </div>

        </div>

        <div class="right-col">
            <div class="vertical-container">
                <span class="v-text">Desi: @Model.TotalDesi Ds. - @Model.TotalWeight Kg.</span>
                <div class="v-barcode-placeholder"></div>
                <span class="v-text">@Model.TrackingNumber</span>
            </div>
            <!-- Takip numarasına göre Dinamik Alt QR -->
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=150x150&data=@Model.TrackingNumber" class="qr-bottom" alt="QR Alt">
        </div>
    </div>

</div>

</body>
</html>