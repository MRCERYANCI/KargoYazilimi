
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")

    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")

    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main">
        <section class="section box-pageheader-1" style="background: linear-gradient(rgba(3, 68, 96, 0.8), rgba(3, 68, 96, 0.8)), url('https://images.unsplash.com/photo-1580674684081-7617fbf3d745?auto=format&fit=crop&w=1350&q=80'); background-size: cover; background-position: center; padding: 80px 0;">
            <div class="container text-center">
                <h1 class="color-white mb-20 font-bold-800">Adresten Alım Talebi</h1>
                <p class="font-md color-white">Zamanınız size kalsın! Formu doldurun, kuryemiz kapınıza gelsin.</p>
            </div>
        </section>

        <section class="section pt-80 pb-80">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-5 mb-40">
                        <h2 class="color-brand-2 mb-20">Kurye Çağırmak <br class="d-none d-lg-block">Artık Çok Kolay</h2>
                        <p class="font-md color-grey-700 mb-30">Kayseri genelindeki geniş araç filomuzla, gönderilerinizi kapınızdan alıyor ve alıcısına en hızlı şekilde ulaştırıyoruz.</p>

                        <ul class="list-ticks list-ticks-2">
                            <li><strong>Anlık Bildirim:</strong> Talebiniz onaylandığında SMS ile bilgilendirilirsiniz.</li>
                            <li><strong>Hızlı Alım:</strong> Saat 12:00'den önce oluşturulan talepler aynı gün alınır.</li>
                            <li><strong>Güvenli Teslimat:</strong> Tüm alımlarımız dijital zimmet kaydıyla başlar.</li>
                        </ul>

                        <div class="bg-grey-100 p-30 bd-rd16 mt-40 border-left-brand">
                            <h6 class="color-brand-2 mb-10">Müşteri Hizmetleri</h6>
                            <h4 class="color-brand-1">+90 352 123 45 67</h4>
                            <p class="font-xs color-grey-500">Pazartesi - Cumartesi: 08:30 - 18:00</p>
                        </div>
                    </div>

                    <div class="col-lg-7">
                        <div class="box-contactform-left border bd-rd16 shadow-lg bg-white" style="padding: 40px;">
                            <form action="#">
                                <div class="row">
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">Adınız Soyadınız / Unvan</label>
                                            <input class="form-control" type="text" placeholder="Örn: Ahmet Yılmaz">
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">Telefon Numaranız</label>
                                            <input class="form-control" type="tel" placeholder="05XX XXX XX XX">
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">İlçe</label>
                                            <select class="form-control">
                                                <option value="">Seçiniz</option>
                                                <option value="Melikgazi">Melikgazi</option>
                                                <option value="Kocasinan">Kocasinan</option>
                                                <option value="Talas">Talas</option>
                                                <option value="Hacilar">Hacılar</option>
                                                <option value="Organize">Organize Sanayi</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-lg-6">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">Kargo Tipi</label>
                                            <select class="form-control">
                                                <option value="Dosya">Dosya / Evrak</option>
                                                <option value="Paket">Paket / Koli</option>
                                                <option value="Agir">Palet / Ağır Yük</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">Tam Adres</label>
                                            <textarea class="form-control" rows="3" placeholder="Mahalle, Cadde, Sokak, Kapı No..."></textarea>
                                        </div>
                                    </div>

                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label class="font-sm-bold color-grey-900 mb-10">Ek Not (Varsa Daire No, Zil vb.)</label>
                                            <input class="form-control" type="text" placeholder="Kargonun içeriği veya alım saati tercihi...">
                                        </div>
                                    </div>

                                    <div class="col-lg-12 mt-20">
                                        <button class="btn btn-brand-1-big w-100" type="submit">
                                            <svg class="icon-16 mr-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                                            TALEBİ GÖNDER
                                        </button>
                                        <p class="font-xxs color-grey-500 mt-15 text-center">Talebinizle birlikte <a href="legal.html" class="color-brand-2">Kişisel Verilerin Korunması</a> şartlarını kabul etmiş sayılırsınız.</p>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    @await Component.InvokeAsync("_DefaultFooterComponentPartial")

    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
