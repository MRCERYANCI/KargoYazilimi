@model CreateCareerApplicationDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")

    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")

    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")
    <main class="main">
        <section class="section box-pageheader-1" style="background: linear-gradient(rgba(3, 68, 96, 0.85), rgba(3, 68, 96, 0.85)), url('https://images.unsplash.com/photo-1519003722824-194d4455a60c?auto=format&fit=crop&w=1600&q=80'); background-size: cover; background-position: center; padding: 120px 0;">
            <div class="container text-center">
                <span class="btn btn-tag mb-15" style="background: rgba(254, 194, 1, 0.2); color: #FEC201; border: 1px solid #FEC201;">Kayseri Lojistik Operasyonu</span>
                <h1 class="color-white mb-20 font-bold-800" style="font-size: 48px;">Ekibimize Katılın</h1>
                <p class="font-md color-white opacity-75 max-width-600 mx-auto">Teknoloji odaklı lojistik ağımızda, profesyonel bir kariyer için ilk adımı atın.</p>
            </div>
        </section>

        <section class="section pt-80 pb-80 bg-grey-100">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-lg-12">
                        <div class="box-contactform-left border bd-rd16 shadow-lg bg-white overflow-hidden">
                            <div class="row g-0">
                                <div class="col-lg-12 p-40 p-md-50">

                                    @if (TempData["SuccessMessage"] != null)
                                    {
                                        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-30" role="alert" style="background-color: #d4edda; color: #155724; border-radius: 12px; padding: 20px;">
                                            <div class="d-flex align-items-center">
                                                <svg class="w-6 h-6 me-2" style="width: 24px;" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                                <strong>Harika!</strong> &nbsp; @TempData["SuccessMessage"]
                                            </div>
                                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                        </div>
                                    }

                                    <h4 class="color-brand-2 mb-30">Ayrıntılı Başvuru Formu</h4>
                                    <form asp-action="Kariyer" asp-controller="Default" method="POST" enctype="multipart/form-data">
                                        <div class="row">
                                            <div class="col-md-6 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Ad Soyad</label>
                                                <input class="form-control" asp-for="FullName" type="text" placeholder="Örn: Ahmet Yılmaz" required>
                                            </div>
                                            <div class="col-md-6 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">E-Posta Adresiniz</label>
                                                <input class="form-control" asp-for="Email" type="email" placeholder="ahmet@email.com" required>
                                            </div>
                                            <div class="col-md-6 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Telefon Numarası</label>
                                                <input class="form-control" asp-for="Phone" type="tel" placeholder="05XX XXX XX XX" required>
                                            </div>
                                            <div class="col-md-6 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Başvurulan Pozisyon</label>
                                                <select class="form-control" asp-for="Position" required>
                                                    <option value="">Seçiniz...</option>
                                                    <option value="Sürücü">Sürücü / Kurye (B/E Sınıfı)</option>
                                                    <option value="Kamyon Şoförü">Ağır Vasıta Şoförü (C/D/G Sınıfı)</option>
                                                    <option value="Depo">Depo ve Sevkiyat Görevlisi</option>
                                                    <option value="IT">IT ve Yazılım Destek Uzmanı</option>
                                                    <option value="Yönetim">Ofis ve Operasyon Yönetimi</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Ehliyet Sınıfı</label>
                                                <input class="form-control" asp-for="LicenseClass" type="text" placeholder="Örn: B, C, SRC4">
                                            </div>
                                            <div class="col-md-4 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Sektörel Tecrübe (Yıl)</label>
                                                <select class="form-control" asp-for="ExperienceYear">
                                                    <option value="0-1">0 - 1 Yıl</option>
                                                    <option value="1-3">1 - 3 Yıl</option>
                                                    <option value="3-5">3 - 5 Yıl</option>
                                                    <option value="5+">5+ Yıl</option>
                                                </select>
                                            </div>
                                            <div class="col-md-4 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Askerlik Durumu</label>
                                                <select class="form-control" asp-for="MilitaryStatus">
                                                    <option value="Yapıldı">Yapıldı</option>
                                                    <option value="Muaf">Muaf</option>
                                                    <option value="Tecilli">Tecilli</option>
                                                </select>
                                            </div>
                                            <div class="col-md-12 mb-20">
                                                <label class="font-sm-bold color-grey-900 mb-10">Özgeçmiş Yükle (Sadece PDF)</label>
                                                <div class="form-group border bd-rd8 p-10 bg-grey-100">
                                                    <input class="form-control-file" asp-for="CVFile" type="file" accept=".pdf" required>
                                                </div>
                                            </div>
                                            <div class="col-md-12 mb-30">
                                                <label class="font-sm-bold color-grey-900 mb-10">Kısa Ön Yazı</label>
                                                <textarea class="form-control" asp-for="CoverLetter" rows="3" placeholder="Kendinizden bahsedin..."></textarea>
                                            </div>
                                            <div class="col-md-12">
                                                <button class="btn btn-brand-1-big w-100" type="submit" style="background: #FEC201; color: #034460; font-weight: 800; border: none; padding: 18px;">BAŞVURUYU TAMAMLA VE GÖNDER</button>
                                            </div>
                                        </div>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")

    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
