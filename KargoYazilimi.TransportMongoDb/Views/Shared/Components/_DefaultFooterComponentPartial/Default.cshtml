    <!-- Tıklanınca Açılacak Olan Tam Ekran Resim Kutusu (Lightbox Modal) -->
    <div id="galleryModal" style="display: none; position: fixed; z-index: 99999; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.85); align-items: center; justify-content: center; backdrop-filter: blur(5px);">
        <!-- Kapatma Butonu -->
        <span style="position: absolute; top: 20px; right: 40px; color: #fff; font-size: 45px; font-weight: bold; cursor: pointer; transition: 0.3s;" onmouseover="this.style.color='#f59e0b'" onmouseout="this.style.color='#fff'" onclick="closeGalleryModal()">&times;</span>
        <!-- Büyütülen Resim -->
        <img id="galleryModalImg" src="" alt="Galeri Büyütülmüş Resim" style="max-width: 90%; max-height: 90%; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
    </div>

    <!-- Galeri Açma ve Kapatma İşlemlerini Yapan Script -->
    <script>
        function openGalleryModal(imageSrc) {
            var modal = document.getElementById("galleryModal");
            var modalImg = document.getElementById("galleryModalImg");

            modalImg.src = imageSrc; // Tıklanan resmin kaynağını büyütülmüş resme ata
            modal.style.display = "flex"; // Modalı görünür yap
            document.body.style.overflow = "hidden"; // Arka planın kaymasını engelle
        }

        function closeGalleryModal() {
            var modal = document.getElementById("galleryModal");
            modal.style.display = "none"; // Modalı gizle
            document.body.style.overflow = "auto"; // Arka plan kaydırmasını geri aç
        }

        // Kullanıcı resim dışındaki siyah alana tıklarsa da kapansın
        document.getElementById("galleryModal").addEventListener('click', function(e) {
            if (e.target !== document.getElementById("galleryModalImg")) {
                closeGalleryModal();
            }
        });
    </script>
