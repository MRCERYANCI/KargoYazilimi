<style>
    /* Geniş ve Modern Layout */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.95);
        display: flex;
        justify-content: center;
        align-items: center;
        z-index: 10000;
        padding: 20px;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .modal-container {
        background: #ffffff;
        width: 100%;
        max-width: 850px; /* Daha geniş alan */
        border-radius: 20px;
        display: flex;
        overflow: hidden;
        box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.5);
        animation: slideUp 0.5s ease-out;
    }

    @@keyframes slideUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Yan taraftaki mavi şerit */
    .modal-side-accent {
        width: 12px;
        background: linear-gradient(to bottom, #2563eb, #3b82f6);
    }

    .modal-main-content {
        flex: 1;
        padding: 50px;
    }

    .status-badge {
        display: inline-block;
        background: #eff6ff;
        color: #2563eb;
        padding: 6px 14px;
        border-radius: 99px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 15px;
    }

    h1 {
        margin: 0 0 25px 0;
        color: #0f172a;
        font-size: 1.8rem;
        font-weight: 800;
    }

    .main-desc p {
        font-size: 17px;
        color: #334155;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .info-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
        margin-bottom: 30px;
    }

        .info-columns h3 {
            font-size: 15px;
            color: #0f172a;
            margin-bottom: 10px;
        }

        .info-columns p {
            font-size: 14px;
            color: #64748b;
            line-height: 1.5;
            margin: 0;
        }

    .legal-notice {
        background: #f8fafc;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
    }

        .legal-notice p {
            font-size: 13px;
            color: #475569;
            margin: 0;
            line-height: 1.5;
        }

    .modal-footer {
        margin-top: 40px;
        display: flex;
        justify-content: flex-end;
    }

    .primary-btn {
        background: #0f172a;
        color: #ffffff;
        border: none;
        padding: 16px 35px;
        border-radius: 10px;
        font-weight: 600;
        font-size: 16px;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .primary-btn:hover {
