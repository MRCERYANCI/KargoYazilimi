            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    /* Mobil Uyumluluk */
    @@media (max-width: 768px) {
        .modal-main-content

    {
        padding: 30px;
    }

    .info-columns {
        grid-template-columns: 1fr;
    }

    .modal-side-accent {
        display: none;
    }

    }
</style>

<script>
    function dismissDisclaimer() {
        const modal = document.getElementById('projectDisclaimer');
        modal.style.opacity = '0';
        modal.style.transition = 'opacity 0.4s ease';
        setTimeout(() => {
            modal.style.display = 'none';
            localStorage.setItem('wide_disclaimer_accepted', 'true');
        }, 400);
    }

    window.onload = function() {
        if (localStorage.getItem('wide_disclaimer_accepted') === 'true') {
            document.getElementById('projectDisclaimer').style.display = 'none';
        }
    }
</script> *@