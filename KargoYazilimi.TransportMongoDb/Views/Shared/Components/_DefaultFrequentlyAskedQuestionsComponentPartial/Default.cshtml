@model List<ResultQuestionDto>

<section class="section pt-80 mb-70 bg-faqs">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="box-faqs-left">
                    <h2 class="title-favicon mb-20">Sıkça Sorulan Sorular</h2>
                    <p class="font-md color-grey-700 mb-50">Aklınıza takılan bir soru mu var? Sıkça sorulan soruları inceleyebilir veya destek ekibimizle iletişime geçebilirsiniz.</p>
                    <div class="box-gallery-faqs">
                        <div class="image-top"> <img src="~/templates/assets/imgs/page/homepage1/img-faq1.png" alt="lojistik-destek"></div>
                        <div class="image-bottom">
                            <div class="image-faq-1"> <img src="~/templates/assets/imgs/page/homepage1/img-faq2.png" alt="sevkiyat-takibi"></div>
                            <div class="image-faq-2"> <img src="~/templates/assets/imgs/page/homepage1/img-faq3.png" alt="musteri-hizmetleri"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="box-accordion">
                    <div class="accordion" id="accordionFAQ">
                        @{
                            int i = 0;
                        }
                        @foreach (var item in Model.Where(x=>x.IsActive).OrderBy(x => x.OrderNo))
                        {
                            i++;
                            <div class="accordion-item">
                                <h5 class="accordion-header" id="heading-@i">
                                    <button class="accordion-button text-heading-5 @(i == 1 ? "" : "collapsed")"
                                            type="button"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#collapse-@i"
                                            aria-expanded="@(i == 1 ? "true" : "false")"
                                            aria-controls="collapse-@i">
                                        @item.QuestionTitle
                                    </button>
                                </h5>
                                <div id="collapse-@i"
                                     class="accordion-collapse collapse @(i == 1 ? "show" : "")"
                                     aria-labelledby="heading-@i"
                                     data-bs-parent="#accordionFAQ">
                                    <div class="accordion-body">
                                        @item.Answer
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="line-border mt-50 mb-50"></div>
                    <h3 class="color-brand-2">Daha fazla yardıma mı ihtiyacınız var?</h3>
                    <div class="mt-20">
                        <a class="btn btn-brand-1-big mr-20" href="/Contact/Index">Bize Ulaşın</a>
                        <a class="btn btn-link-medium" href="#">
                            Daha Fazla Bilgi
                            <svg class="w-6 h-6 icon-16 ml-5" fill="none" stroke="currentColor" viewbox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>