@model List<ResultAboutDto>

@{
    ViewData["Title"] = "AboutList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-patch-check-fill me-2 text-primary"></i>Hakkımızda Yönetimi
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Hakkımızca Tablosu</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 border-radius-15">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">Kayıtlı Marka Listesi</h5>
                <a href="/About/CreateAbout" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Hakkımızda Ekle
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Görsel / İkon</th>
                                <th>Başlık</th>
                                <th>Açıklama Özeti</th>
                                <th class="text-center">Özellik Sayısı</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td class="fw-bold">@count</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ImageUrl" alt="Logo" class="rounded border p-1 bg-light" style="width: 50px; height: 50px; object-fit: contain;">
                                                <div class="ms-3">
                                                    <span class="d-block fw-semibold text-dark">Marka Logosu</span>
                                                    <small class="text-muted">ID: @item.AboutId.Substring(0, 8)...</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td><span class="fw-bold text-dark">@item.Title</span></td>
                                        <td>
                                            <span class="text-truncate d-inline-block" style="max-width: 250px;" title="@item.Description">
                                                @item.Description
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill">
                                                <i class="bi bi-list-check me-1"></i> @item.Features.Count Madde
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group shadow-sm rounded">
                                                <a href="/About/UpdateAbout/@item.AboutId" class="btn btn-outline-warning btn-sm border-0" title="Düzenle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <button onclick="deleteAbout('@item.AboutId')" class="btn btn-outline-danger btn-sm border-0" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-exclamation-circle display-4 d-block mb-3"></i>
                                        Henüz bir kayıt bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-radius-15 {
        border-radius: 15px;
    }

    .custom-table thead th {
        border-top: none;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        font-size: 12px;
        letter-spacing: 0.5px;
    }

    .bg-info-subtle {
        background-color: #e0f2fe !important;
    }

    .text-info {
        color: #0284c7 !important;
    }

    .btn-group .btn:hover {
        background-color: #f8fafc;
    }

    .table-hover tbody tr:hover {
        background-color: #fcfdfe;
        transition: 0.2s;
    }
</style>

<script>
    function deleteAbout(id) {
        if (confirm("Bu kaydı silmek istediğinizden emin misiniz?")) {
            window.location.href = "/About/DeleteAbout/" + id;
        }
    }
</script>

