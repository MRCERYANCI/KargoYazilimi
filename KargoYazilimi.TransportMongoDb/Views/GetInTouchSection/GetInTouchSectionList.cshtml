@model List<ResultGetInTouchSectionDto>

@{
    ViewData["Title"] = "GetInTouchList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-headset me-2 text-primary"></i>İletişim Bölümü Yönetimi
        </h4>
    </div>
    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">İletişim Listesi</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 border-radius-15">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">Bize Ulaşın Bölüm İçerikleri</h5>
                <a href="/GetInTouchSection/CreateGetInTouchSection" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Ekle
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">#</th>
                                <th>Görsel</th>
                                <th>Etiket & Başlık</th>
                                <th>Alt Özellikler (Sub-Sections)</th>
                                <th>Buton Bilgisi</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td><span class="fw-bold">@count</span></td>
                                        <td>
                                            <div class="position-relative d-inline-block">
                                                <img src="@item.BackgroundImageUrl" alt="Background" class="rounded shadow-sm border" style="width: 80px; height: 50px; object-fit: cover;">
                                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-info border border-light">BG</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle mb-1" style="width: fit-content;">@item.Tag</span>
                                                <span class="fw-bold text-dark text-truncate" style="max-width: 250px;">@item.Title</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column gap-1">
                                                <small class="text-dark"><i class="bi bi-1-circle text-primary me-1"></i> @item.SubTitle1</small>
                                                <small class="text-dark"><i class="bi bi-2-circle text-primary me-1"></i> @item.SubTitle2</small>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <small class="fw-bold text-dark">@item.ButtonText</small>
                                                <small class="text-muted fs-11">URL: @item.ButtonUrl</small>
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group shadow-sm">
                                                <a href="/GetInTouchSection/UpdateGetInTouchSection/@item.GetInTouchSectionId" class="btn btn-outline-warning btn-sm border-0" title="Düzenle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <button onclick="deleteItem('@item.GetInTouchSectionId')" class="btn btn-outline-danger btn-sm border-0" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox display-4 d-block mb-3"></i>
                                        Henüz bir içerik tanımlanmamış.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-radius-15 {
        border-radius: 15px;
    }

    .custom-table thead th {
        border-top: none;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 15px;
    }

    .bg-primary-subtle {
        background-color: #e0f2fe !important;
    }

    .text-primary {
        color: #034460 !important;
    }

    .fs-11 {
        font-size: 11px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
        transition: 0.2s;
    }
</style>

<script>
    function deleteItem(id) {
        if (confirm("Bu iletişim bölümü içeriğini silmek istediğinizden emin misiniz?")) {
            window.location.href = "/GetInTouchSection/DeleteGetInTouchSection/" + id;
        }
    }
</script>