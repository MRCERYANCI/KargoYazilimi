@model CreateHowItWorkDto

@{
    ViewData["Title"] = "CreateHowItWork";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<br />
<br />
<div class="row justify-content-center">
    <div class="col-xl-12">
        <div class="card shadow-sm border-0" style="border-radius: 15px;">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 fw-bold text-primary">
                    <i class="bi bi-plus-circle me-2"></i>Yeni Süreç Adımı Ekle
                </h5>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <div class="row g-4">
                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Adım Başlığı</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-list-check"></i></span>
                                    <input type="text" asp-for="Title" class="form-control" placeholder="Örn: Müşteri Siparişi Oluşturur" required>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">Adım Açıklaması</label>
                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Adımın detaylarını buraya yazın..." required></textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold text-secondary">İkon URL</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                                    <input type="text" asp-for="IconUrl" id="iconUrlInput" class="form-control" placeholder="https://.../icon.png" oninput="previewIcon(this)" required>
                                </div>
                                <div class="form-text">Temadaki standart ikonları veya harici bir görsel linkini kullanabilirsiniz.</div>
                            </div>
                        </div>

                        <div class="col-md-5 border-start ps-4">
                            <div class="mb-4">
                                <label class="form-label fw-bold text-secondary">İşlem Sırası (OrderNo)</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="bi bi-sort-numeric-down"></i></span>
                                    <input type="number" asp-for="OrderNo" class="form-control" value="1" min="1" required>
                                </div>
                                <small class="text-muted">Bu adımın süreçte kaçıncı sırada görüneceğini belirler.</small>
                            </div>

                            <div class="icon-preview-box text-center p-4 border rounded-3 bg-light bg-opacity-50">
                                <label class="form-label d-block text-start small fw-bold text-muted mb-3">İkon Önizleme</label>
                                <div class="bg-white d-inline-block p-3 rounded-circle shadow-sm border mb-2">
                                    <img id="iconPreview" src="~/templates/assets/imgs/page/homepage1/order.png"
                                         alt="İkon" style="width: 60px; height: 60px; object-fit: contain;">
                                </div>
                                <div id="iconPlaceholder" class="mt-2 small text-muted">Önizleme burada görünecek</div>
                            </div>
                        </div>
                    </div>

                    <div class="text-end mt-4 border-top pt-3">
                        <a href="/HowItWork/HowItWorkList" class="btn btn-light px-4 rounded-pill me-2">İptal</a>
                        <button type="submit" class="btn btn-primary px-5 rounded-pill shadow-sm fw-bold">
                            <i class="bi bi-save me-1"></i> Adımı Kaydet
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function previewIcon(input) {
        var preview = document.getElementById('iconPreview');
        if (input.value && input.value.trim() !== "") {
            preview.src = input.value;
            preview.onerror = function() {
                preview.src = "/templates/assets/imgs/page/homepage1/order.png"; // Hata durumunda default
            };
        } else {
            preview.src = "/templates/assets/imgs/page/homepage1/order.png";
        }
    }
</script>

<style>
    .form-control:focus, .form-select:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1);
    }

    .input-group-text {
        border-radius: 0.5rem 0 0 0.5rem;
    }

    .form-control {
        border-radius: 0 0.5rem 0.5rem 0;
    }
</style>