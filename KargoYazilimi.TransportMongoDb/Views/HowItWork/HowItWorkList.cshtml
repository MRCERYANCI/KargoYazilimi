@model List<ResultHowItWorkDto>

@{
    ViewData["Title"] = "HowItWorkList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-arrow-repeat me-2 text-primary"></i>Süreç Adımları (Nasıl Çalışır?)
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Süreç Listesi</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 border-radius-15">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark fw-bold">İşleyiş Adımları</h5>
                <a href="/HowItWork/CreateHowItWork" class="btn btn-primary btn-sm rounded-pill px-3">
                    <i class="bi bi-plus-lg me-1"></i> Yeni Adım Ekle
                </a>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;">Sıra</th>
                                <th>İkon</th>
                                <th>Başlık</th>
                                <th>Açıklama</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                @* Verileri OrderNo'ya göre sıralayarak listeliyoruz *@
                                foreach (var item in Model.OrderBy(x => x.OrderNo))
                                {
                                    count++;
                                    <tr>
                                        <td>
                                            <span class="badge bg-primary rounded-circle p-2" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">
                                                @item.OrderNo
                                            </span>
                                        </td>
                                        <td>
                                            <div class="bg-light p-2 rounded-3 d-inline-block border">
                                                <img src="@item.IconUrl" alt="icon" style="width: 35px; height: 35px; object-fit: contain;">
                                            </div>
                                        </td>
                                        <td>
                                            <span class="fw-bold text-dark">@item.Title</span>
                                        </td>
                                        <td>
                                            <small class="text-muted d-block" style="max-width: 400px; white-space: normal;">
                                                @item.Description
                                            </small>
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group shadow-sm">
                                                <a href="/HowItWork/UpdateHowItWork/@item.HowItWorkId" class="btn btn-outline-warning btn-sm border-0" title="Düzenle">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <button onclick="deleteStep('@item.HowItWorkId')" class="btn btn-outline-danger btn-sm border-0" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <i class="bi bi-info-circle display-4 text-muted d-block mb-3"></i>
                                        Henüz bir süreç adımı tanımlanmamış.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-radius-15 {
        border-radius: 15px;
    }

    .custom-table thead th {
        border-top: none;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 15px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
        transition: 0.2s;
    }
</style>

<script>
    function deleteStep(id) {
        if (confirm("Bu süreç adımını silmek istediğinizden emin misiniz?")) {
            window.location.href = "/HowItWork/DeleteHowItWork/" + id;
        }
    }
</script>