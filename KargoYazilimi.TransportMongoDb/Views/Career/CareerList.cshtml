@model List<ResultCareerApplicationDto>

@{
    ViewData["Title"] = "CareerList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    int count = 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="modal fade" id="pdfModal" tabindex="-1" aria-labelledby="pdfModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius: 20px; border: none; overflow: hidden; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);">
            <div class="modal-header bg-white border-bottom py-3">
                <h5 class="modal-title fw-bold text-dark" id="pdfModalLabel">
                    <i class="bi bi-file-earmark-pdf text-danger me-2"></i>Kariyer Bilgisi / Özgeçmiş
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 bg-dark" style="height: 75vh;">
                <iframe id="pdfFrame" src="" width="100%" height="100%" style="border: none;"></iframe>
            </div>
            <div class="modal-footer bg-white d-flex justify-content-center flex-column py-3">
                <a id="downloadBtn" href="#" download class="btn btn-warning px-5 rounded-pill fw-bold text-dark shadow-sm mb-2" style="background: #FF6000; background: linear-gradient(90deg, #FF6000 0%, #FF8000 100%); border: none; color: white !important; padding: 15px 40px;">
                    Dokümanı indir <i class="bi bi-download ms-2"></i>
                </a>
                <button type="button" class="btn btn-link text-danger fw-bold text-decoration-none" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<div class="py-3 d-flex align-items-sm-center flex-sm-row flex-column">
    <div class="flex-grow-1">
        <h4 class="fs-18 fw-bold m-0 text-dark">
            <i class="bi bi-people-fill me-2 text-primary"></i>Kariyer & İş Başvurusu Yönetimi
        </h4>
    </div>

    <div class="text-end">
        <ol class="breadcrumb m-0 py-0 text-muted">
            <li class="breadcrumb-item"><a href="javascript: void(0);" class="text-secondary text-decoration-none">Yönetim</a></li>
            <li class="breadcrumb-item active text-primary fw-semibold">Başvuru Listesi</li>
        </ol>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0 border-radius-15">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="card-title mb-0 text-dark fw-bold">Gelen Başvurular</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover align-middle custom-table">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Aday Bilgileri</th>
                                <th>Pozisyon</th>
                                <th>Tecrübe / Askerlik</th>
                                <th>Başvuru Tarihi</th>
                                <th class="text-center">Özgeçmiş</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Count > 0)
                            {
                                foreach (var item in Model)
                                {
                                    count++;
                                    <tr>
                                        <td class="fw-bold">@count</td>
                                        <td>
                                            <div class="d-flex flex-column">
                                                <span class="fw-bold text-dark">@item.FullName</span>
                                                <small class="text-muted"><i class="bi bi-envelope me-1"></i>@item.Email</small>
                                                <small class="text-muted"><i class="bi bi-telephone me-1"></i>@item.Phone</small>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                @item.Position
                                            </span>
                                        </td>
                                        <td>
                                            <div class="fs-12">
                                                <span class="d-block text-dark"><b>Tecrübe:</b> @item.ExperienceYear</span>
                                                <span class="d-block text-muted"><b>Askerlik:</b> @item.MilitaryStatus</span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-muted fs-13">@item.AppliedAt.ToString("dd.MM.yyyy HH:mm")</span>
                                        </td>
                                        <td class="text-center">
                                            @if (!string.IsNullOrEmpty(item.CVPath))
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" onclick="openPdfModal('@item.CVPath')">
                                                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> İncele
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-danger fs-12">Dosya Yok</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="btn-group shadow-sm rounded">
                                                <a href="/Admin/Career/Details/@item.CareerApplicationId" class="btn btn-outline-info btn-sm border-0" title="Detaylar">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <button onclick="deleteApplication('@item.CareerApplicationId')" class="btn btn-outline-danger btn-sm border-0" title="Sil">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5">
                                        <i class="bi bi-inbox display-4 text-muted d-block mb-3"></i>
                                        Henüz bir başvuru bulunmuyor.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-radius-15 {
        border-radius: 15px;
    }

    .custom-table thead th {
        border-top: none;
        font-weight: 700;
        color: #475569;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.5px;
        padding: 15px;
    }

    .bg-primary-subtle {
        background-color: #e0f2fe !important;
    }

    .text-primary {
        color: #034460 !important;
    }

    .fs-12 {
        font-size: 12px;
    }

    .fs-13 {
        font-size: 13px;
    }

    .table-hover tbody tr:hover {
        background-color: #f8fafc;
        transition: 0.2s;
    }

    .modal-xl {
        max-width: 900px;
    }
</style>

<script>
    function openPdfModal(url) {
        document.getElementById('pdfFrame').src = url;
        document.getElementById('downloadBtn').href = url;
        var myModal = new bootstrap.Modal(document.getElementById('pdfModal'));
        myModal.show();
    }

    // Modal kapandığında içeriği temizle
    document.getElementById('pdfModal').addEventListener('hidden.bs.modal', function () {
        document.getElementById('pdfFrame').src = '';
    });

    function deleteApplication(id) {
        if (confirm("Bu başvuruyu silmek istediğinizden emin misiniz? Bu işlem geri alınamaz.")) {
            window.location.href = "/Career/DeleteCareer/" + id;
        }
    }
</script>