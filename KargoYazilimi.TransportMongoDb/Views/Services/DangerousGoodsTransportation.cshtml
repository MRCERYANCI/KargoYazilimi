@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #ffffff; color: #333; line-height: 1.8;">

        <!-- 1. TİPOGRAFİ ODAKLI HERO BÖLÜMÜ (Güvenlik ve Uzmanlık Teması) -->
        <section class="section pt-120 pb-60" style="position: relative; overflow: hidden; background-color: #f8fafc;">

            <!-- ARKA PLAN EFEKTLERİ (Grid ve Güvenlik Odaklı Işık Yansımaları) -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(#cbd5e0 1.5px, transparent 1.5px); background-size: 35px 35px; opacity: 0.5; z-index: 0;"></div>
            <!-- Sol üstte kurumsal mavi yansıma -->
            <div style="position: absolute; top: -150px; left: -100px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(54,97,237,0.15) 0%, rgba(255,255,255,0) 70%); z-index: 0; border-radius: 50%;"></div>
            <!-- Sağ altta dikkati/güvenliği temsil eden kehribar sarısı yansıma -->
            <div style="position: absolute; bottom: 100px; right: -150px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, rgba(255,255,255,0) 70%); z-index: 0; border-radius: 50%;"></div>

            <!-- İÇERİK (Z-index ile öne alındı) -->
            <div class="container text-center" style="position: relative; z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(245, 158, 11, 0.15); color: #d97706; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 2px; font-size: 14px; backdrop-filter: blur(5px);">DGR & GÜVENLİ LOJİSTİK</span>

                <h1 class="mb-4" style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 900; color: #0b1c3d; letter-spacing: -1px; line-height: 1.1;">
                    Tehlikeli Madde <br> Taşımacılığı
                </h1>

                <p class="font-lg mb-5 mx-auto" style="color: #64748b; max-width: 780px;">
                    Yanıcı, patlayıcı, kimyasal veya biyolojik risk taşıyan kargolarınızı; uluslararası havacılık kurallarına (IATA DGR) tam uyumlulukla, sertifikalı uzmanlarımız eşliğinde maksimum güvenlikle taşıyoruz.
                </p>

                <a href="/Contact/Index" class="btn hover-up" style="padding: 16px 45px; font-weight: bold; border-radius: 50px; background-color: #f59e0b; color: white; border: none; box-shadow: 0 15px 30px rgba(245, 158, 11, 0.3);">
                    MSDS Formu Gönderin
                </a>

                <!-- ZARİF GÖRSEL (Yazının altında sinematik şerit) -->
                <div class="mt-5 pt-4">
                    <img src="/templates/assets/imgs/page/homepage1/menu4.png" alt="Tehlikeli Madde Kargo" style="width: 100%; max-width: 1100px; height: 450px; object-fit: cover; border-radius: 30px; box-shadow: 0 30px 60px rgba(0,0,0,0.15); position: relative; z-index: 3;">
                </div>
            </div>
        </section>

        <!-- 2. HİZMET DETAYLARI (Yatay Kutular - DGR Odaklı) -->
        <section class="section pt-80 pb-100" style="background-color: #ffffff;">
            <div class="container">
                <div class="row justify-content-center mb-60">
                    <div class="col-lg-8 text-center">
                        <h2 class="mb-3" style="color: #0b1c3d;">Sıfır Risk, Tam Uyum</h2>
                        <p class="font-lg" style="color: #64748b;">
                            Lityum bataryalardan yanıcı sıvılara, zehirli maddelerden radyoaktif ürünlere kadar tüm tehlikeli madde sınıfları (Class 1-9) için uluslararası prosedürleri sizin adınıza yönetiyoruz.
                        </p>
                    </div>
                </div>

                <!-- 2x2 Güvenlik Odaklı Grid -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fffbeb; border-radius: 20px; border: 1px solid #fef3c7; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">📜</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Uzman Dokümantasyon</h4>
                                <p class="mb-0 text-muted">Shipper's Declaration (DGD) hazırlığı, MSDS kontrolleri ve uluslararası kurallara uygun evrak yönetimi.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fffbeb; border-radius: 20px; border: 1px solid #fef3c7; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">📦</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">UN Onaylı Ambalajlama</h4>
                                <p class="mb-0 text-muted">Yükünüzün tehlike sınıfına uygun, sızdırmaz ve darbe emici özel Birleşmiş Milletler (UN) onaylı paketleme çözümleri.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fffbeb; border-radius: 20px; border: 1px solid #fef3c7; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">🏷️</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Doğru Etiketleme</h4>
                                <p class="mb-0 text-muted">Kargonuzun havalimanlarında reddedilmemesi için IATA DGR kurallarına birebir uygun tehlike etiketlemesi (Labeling).</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fffbeb; border-radius: 20px; border: 1px solid #fef3c7; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">🎓</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Sertifikalı Personel</h4>
                                <p class="mb-0 text-muted">Tüm operasyon süreci, güncel eğitimlerini tamamlamış DGR (Category 1, 3, 6) sertifikalı uzmanlarımızca yürütülür.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. OPERASYON SÜRECİ (Karanlık Tema - Hassas Süreç) -->
        <section class="section pt-100 pb-120" style="background-color: #0b1c3d; color: white;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2 class="text-white">Tehlikeli Madde Taşıma Prosedürü</h2>
                    <p style="color: #94a3b8;">Hiçbir detayın şansa bırakılmadığı, %100 kurallara uygun 4 aşamalı kontrol.</p>
                </div>

                <div class="row text-center position-relative mt-5">
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(245, 158, 11, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #f59e0b; border: 2px solid #f59e0b;">1</div>
                        <h5 class="text-white mb-3">MSDS & Sınıflandırma</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Gönderdiğiniz Güvenlik Bilgi Formu (MSDS) incelenerek ürünün tehlike sınıfı ve BM (UN) numarası belirlenir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(245, 158, 11, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #f59e0b; border: 2px solid #f59e0b;">2</div>
                        <h5 class="text-white mb-3">Ambalaj & Evrak</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Uygun iç ve dış ambalajlama yapılır, tehlike etiketleri yapıştırılır ve DGD evrakları tanzim edilir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(245, 158, 11, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #f59e0b; border: 2px solid #f59e0b;">3</div>
                        <h5 class="text-white mb-3">Özel Terminal İşlemi</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Kargo, havalimanında DGR odalarına alınır ve havayolunun DGR kabul kontrollerinden (Check-list) geçirilir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: #f59e0b; border-radius: 50%; font-size: 24px; font-weight: bold; color: #ffffff; border: 2px solid #f59e0b;">4</div>
                        <h5 class="text-white mb-3">Güvenli Seyir</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Uçağın ilgili kargo bölümünde (Gerekirse sadece kargo uçağında - CAO) güvenli bir şekilde varış noktasına ulaştırılır.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. YÜZEN ÇAĞRI KUTUSU (Güvenlik Odaklı CTA) -->
        <div class="container" style="margin-top: -60px; position: relative; z-index: 10;">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div style="background: linear-gradient(135deg, #1e3a8a 0%, #172554 100%); border-radius: 20px; padding: 40px 50px; box-shadow: 0 20px 40px rgba(11, 28, 61, 0.4); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; border: 1px solid rgba(255,255,255,0.1);">
                        <div class="mb-3 mb-md-0">
                            <h3 style="color: #ffffff; margin-bottom: 5px;">Risk Almayın, İşi Uzmanına Bırakın</h3>
                            <p style="color: #93c5fd; margin-bottom: 0; font-size: 16px; font-weight: 500;">Kimyasal veya tehlikeli kargolarınız için uygunluk analizi ve fiyatlandırma talep edin.</p>
                        </div>
                        <a href="/Contact/Index" class="btn hover-up" style="background: #f59e0b; color: #ffffff; padding: 15px 35px; font-weight: bold; border-radius: 50px; font-size: 16px; box-shadow: 0 10px 20px rgba(245, 158, 11, 0.3);">Uzmanımızla Görüşün</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alt Boşluk -->
        <div style="height: 100px; background-color: #ffffff;"></div>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
