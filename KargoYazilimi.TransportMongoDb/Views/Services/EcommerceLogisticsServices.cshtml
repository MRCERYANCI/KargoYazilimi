@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #f8fafc; color: #333; line-height: 1.8; font-family: 'Segoe UI', sans-serif;">

        <!-- 1. GÖRKEMLİ HERO BÖLÜMÜ (Dijital E-Ticaret Teması) -->
        <section class="section pt-120 pb-120" style="position: relative; background: linear-gradient(rgba(17, 24, 39, 0.85), rgba(88, 28, 135, 0.9)), url('https://images.unsplash.com/photo-1556742049-0cfed4f6a45d?auto=format&fit=crop&q=80&w=1920') center/cover fixed;">
            <!-- Noktalı Dijital Ağ Deseni -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(rgba(236, 72, 153, 0.15) 1px, transparent 1px); background-size: 30px 30px; z-index: 1;"></div>

            <div class="container text-center position-relative" style="z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(236, 72, 153, 0.2); color: #f472b6; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 2px; font-size: 14px; border: 1px solid rgba(236, 72, 153, 0.4);">SIFIR HATA, MAKSİMUM MÜŞTERİ MEMNUNİYETİ</span>

                <h1 class="text-white mb-4" style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1;">
                    E-Ticaret Lojistik <br> <span style="color: #f472b6;">Hizmetleri</span>
                </h1>

                <p class="font-lg text-white opacity-80 mb-5 mx-auto" style="max-width: 750px;">
                    Siz sadece satışlarınızı artırmaya ve markanızı büyütmeye odaklanın. "Satın Al" butonuna tıklandığı andan itibaren; ürünün depodan toplanması, markanıza özel paketlenmesi ve son kullanıcıya aynı gün ulaştırılması ÇokkeçeciJET güvencesi altındadır.
                </p>

                <a href="/Contact/Index" class="btn" style="background: #ec4899; color: white; padding: 16px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; border: none; box-shadow: 0 10px 20px rgba(236, 72, 153, 0.3);">
                    E-Ticaret Entegrasyonu Başlat
                </a>
            </div>
        </section>

        <!-- 2. KONSEPT AÇIKLAMASI (Deneyim ve Hız) -->
        <section class="section pt-100 pb-80" style="background-color: #ffffff;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                        <h2 class="mb-4" style="color: #111827; font-size: 2.5rem;">Ürünü Değil, <br><span style="color: #8b5cf6;">Marka Deneyimini Taşıyoruz</span></h2>
                        <p class="text-muted font-lg mb-4">
                            E-ticarette rekabet artık sadece fiyatta değil, teslimat hızında ve paketleme kalitesinde (unboxing) yaşanıyor. Geç veya hasarlı giden bir kargo, doğrudan markanızın itibarını zedeler.
                        </p>
                        <p class="text-muted font-lg mb-4">
                            ÇokkeçeciJET e-lojistik (fulfillment) çözümleriyle; pazaryerleri (Trendyol, Hepsiburada, Amazon vb.) ve kendi web siteniz (Shopify, WooCommerce, Ticimax vb.) ile saniyeler içinde entegre oluyoruz. Sipariş düştüğü an operasyon başlıyor. Kampanya dönemlerindeki (Efsane Cuma vb.) aşırı yoğunlukları ölçeklenebilir altyapımızla sorunsuz atlatıyoruz.
                        </p>
                        <div class="d-flex align-items-center p-3 mt-4" style="background: #f5f3ff; border-left: 4px solid #8b5cf6; border-radius: 0 10px 10px 0;">
                            <div style="font-size: 24px; margin-right: 15px;">🔌</div>
                            <p class="mb-0" style="color: #4c1d95; font-weight: 500;">Tüm e-ticaret altyapıları ve pazaryerleri ile tek tıkla tam (API) entegrasyon.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 position-relative">
                        <!-- Gerçek Unsplash Görseli (E-Ticaret Kutuları/Alışveriş) -->
                        <div style="position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                            <img src="https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?auto=format&fit=crop&q=80&w=800" alt="E-Ticaret Lojistik Paketleme" style="width: 100%; display: block;">
                            <!-- Yüzen Kutu -->
                            <div style="position: absolute; bottom: 30px; left: 30px; background: rgba(255,255,255,0.95); padding: 15px 25px; border-radius: 10px; box-shadow: 0 10px 20px rgba(0,0,0,0.1); border-left: 4px solid #ec4899;">
                                <h6 class="mb-0" style="color: #111827; font-weight: bold;">Aynı Gün Kargo</h6>
                                <p class="text-muted font-sm mb-0">Saat 15:00'e kadar gelen siparişler</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. E-TİCARET OPERASYON ADIMLARI (Kartlı Yapı) -->
        <section class="section pt-80 pb-100" style="background-color: #f8fafc;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2 style="color: #111827;">Uçtan Uca E-Ticaret Lojistiği</h2>
                    <p class="text-muted font-lg">Tedarikçinizden aldığımız ürünü, müşterinizin kapısına ulaştırana kadar sunduğumuz hizmetler.</p>
                </div>

                <div class="row g-4">
                    <!-- Depolama ve Entegrasyon -->
                    <div class="col-lg-3 col-md-6">
                        <div class="p-4" style="background: #ffffff; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); height: 100%; border-top: 4px solid #8b5cf6; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f5f3ff; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #8b5cf6; margin-bottom: 20px;">💻</div>
                            <h5 style="color: #111827; margin-bottom: 15px;">API & Depolama</h5>
                            <p class="text-muted font-sm mb-0">Ürünleriniz modern e-ticaret raflarımıza yerleştirilir. Sitenizle API entegrasyonu kurularak stoklarınız anlık senkronize edilir.</p>
                        </div>
                    </div>

                    <!-- Picking & Packing -->
                    <div class="col-lg-3 col-md-6">
                        <div class="p-4" style="background: #ffffff; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); height: 100%; border-top: 4px solid #8b5cf6; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f5f3ff; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #8b5cf6; margin-bottom: 20px;">📦</div>
                            <h5 style="color: #111827; margin-bottom: 15px;">Toplama & Paketleme</h5>
                            <p class="text-muted font-sm mb-0">Sipariş düştüğü an el terminalleriyle hatasız toplanır (Picking). Markanıza özel koliler, bantlar ve broşürlerle şık bir şekilde paketlenir (Packing).</p>
                        </div>
                    </div>

                    <!-- Last Mile Delivery -->
                    <div class="col-lg-3 col-md-6">
                        <div class="p-4" style="background: #ffffff; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); height: 100%; border-top: 4px solid #8b5cf6; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f5f3ff; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #8b5cf6; margin-bottom: 20px;">🚀</div>
                            <h5 style="color: #111827; margin-bottom: 15px;">Son Kilometre (Last Mile)</h5>
                            <p class="text-muted font-sm mb-0">Hazırlanan paketler dağıtım ağına aktarılır. SMS ve canlı kargo takip linki ile müşterinize adım adım şeffaf bir teslimat deneyimi yaşatılır.</p>
                        </div>
                    </div>

                    <!-- İade Yönetimi -->
                    <div class="col-lg-3 col-md-6">
                        <div class="p-4" style="background: #ffffff; border-radius: 15px; box-shadow: 0 10px 30px rgba(0,0,0,0.03); height: 100%; border-top: 4px solid #8b5cf6; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f5f3ff; width: 60px; height: 60px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 24px; color: #8b5cf6; margin-bottom: 20px;">🔄</div>
                            <h5 style="color: #111827; margin-bottom: 15px;">Tersine Lojistik (İade)</h5>
                            <p class="text-muted font-sm mb-0">E-ticaretin zorluklarından olan iade süreçleri hızla yönetilir. Ürün depoya gelir, kalite kontrolden geçer, hasarsızsa anında tekrar stoğa eklenir.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. NEDEN BİZİMLE ÇALIŞMALISINIZ? (Karanlık Mor Tema) -->
        <section class="section pt-80 pb-100" style="background-color: #2e1065; color: white;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-5 mb-5 mb-lg-0">
                        <span class="d-inline-block mb-3" style="color: #f472b6; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">Katma Değer</span>
                        <h2 class="text-white mb-4">E-Ticarette<br>Gizli Kahramanınız</h2>
                        <p style="color: #c4b5fd; font-size: 16px; margin-bottom: 30px;">
                            Sabit depo kiraları, paketleme personeli maaşları, koli masrafları ve yazılım maliyetleri altında ezilmeyin. Kullandıkça öde (Pay-as-you-go) modelimizle lojistik maliyetlerinizi değişken gider haline getirin.
                        </p>
                        <a href="/Contact/Index" class="btn" style="background: transparent; color: white; border: 2px solid #f472b6; padding: 12px 30px; border-radius: 8px; font-weight: bold; transition: 0.3s;" onmouseover="this.style.background='#f472b6'; this.style.borderColor='#f472b6'" onmouseout="this.style.background='transparent'; this.style.borderColor='#f472b6'">Kargo Fiyat Listesi İste</a>
                    </div>
                    <div class="col-lg-7">
                        <div class="row g-4">
                            <div class="col-sm-6">
                                <div class="p-4" style="background: rgba(255,255,255,0.05); border-radius: 15px; border-left: 3px solid #f472b6;">
                                    <div style="font-size: 30px; margin-bottom: 15px;">📈</div>
                                    <h4 class="mb-2" style="color: #ffffff;">Esnek Ölçeklenebilirlik</h4>
                                    <p style="color: #c4b5fd; font-size: 14px; margin-bottom: 0;">Sevgililer Günü, Anneler Günü veya Black Friday gibi anlık sipariş patlamalarında altyapımız sarsılmaz.</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="p-4" style="background: rgba(255,255,255,0.05); border-radius: 15px; border-left: 3px solid #f472b6;">
                                    <div style="font-size: 30px; margin-bottom: 15px;">📱</div>
                                    <h4 class="mb-2" style="color: #ffffff;">Gerçek Zamanlı Takip</h4>
                                    <p style="color: #c4b5fd; font-size: 14px; margin-bottom: 0;">Siz satıcı panelinizden stokları izlerken, müşteriniz mobil uygulama üzerinden kargosunu canlı haritada izler.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. CTA BÖLÜMÜ -->
        <section class="section pt-80 pb-80 text-center" style="background: #ffffff; border-top: 5px solid #8b5cf6;">
            <div class="container">
                <h2 class="mb-4" style="color: #111827;">Markanızı Zirveye Taşımaya Hazır mısınız?</h2>
                <p class="font-lg mb-5 mx-auto text-muted" style="max-width: 600px;">Aylık gönderi hacminizi bizimle paylaşın, e-ticaret sitenize ve pazaryeri mağazalarınıza özel en rekabetçi lojistik (fulfillment & kargo) teklifimizi sunalım.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/Contact/Index" class="btn" style="background: #8b5cf6; color: white; padding: 18px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; box-shadow: 0 10px 20px rgba(139, 92, 246, 0.3);">E-Ticaret Teklifi Al</a>
                    <a href="/Hizmetler/Depolama" class="btn" style="background: white; color: #111827; padding: 18px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; border: 2px solid #e2e8f0;">Depolama Çözümleri</a>
                </div>
            </div>
        </section>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>