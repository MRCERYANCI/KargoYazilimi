@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #ffffff; color: #333; line-height: 1.8;">

        <!-- 1. TİPOGRAFİ ODAKLI, DİNAMİK HERO BÖLÜMÜ (Hız ve Aciliyet Teması) -->
        <section class="section pt-120 pb-60" style="position: relative; overflow: hidden; background-color: #f8fafc;">

            <!-- ARKA PLAN EFEKTLERİ (Grid ve Enerjik Işık Yansımaları) -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(#cbd5e0 1.5px, transparent 1.5px); background-size: 35px 35px; opacity: 0.5; z-index: 0;"></div>
            <!-- Sol üstte güven veren mavi yansıma -->
            <div style="position: absolute; top: -150px; left: -100px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(54,97,237,0.15) 0%, rgba(255,255,255,0) 70%); z-index: 0; border-radius: 50%;"></div>
            <!-- Sağ altta hızı temsil eden turuncu/kırmızı yansıma -->
            <div style="position: absolute; bottom: 100px; right: -150px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(255, 77, 77, 0.1) 0%, rgba(255,255,255,0) 70%); z-index: 0; border-radius: 50%;"></div>

            <!-- İÇERİK (Z-index ile öne alındı) -->
            <div class="container text-center" style="position: relative; z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(255, 77, 77, 0.1); color: #ff4d4d; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 2px; font-size: 14px; backdrop-filter: blur(5px);">V.I.P & ACİL LOJİSTİK</span>

                <h1 class="mb-4" style="font-size: clamp(3rem, 6vw, 5rem); font-weight: 900; color: #0b1c3d; letter-spacing: -1px;">
                    Express Taşımacılık
                </h1>

                <p class="font-lg mb-5 mx-auto" style="color: #64748b; max-width: 750px;">
                    Dakikaların bile kritik öneme sahip olduğu anlarda; üretim bandınızın durmaması, krizlerin çözülmesi veya hayati kargoların yetişmesi için "İlk Uçakla" VIP teslimat sağlıyoruz.
                </p>

                <a href="/Contact/Index" class="btn hover-up" style="padding: 16px 45px; font-weight: bold; border-radius: 50px; background-color: #ff4d4d; color: white; border: none; box-shadow: 0 15px 30px rgba(255, 77, 77, 0.25);">
                    Acil Teklif Alın
                </a>

                <!-- ZARİF GÖRSEL (Yazının altında sinematik şerit) -->
                <div class="mt-5 pt-4">
                    <img src="/templates/assets/imgs/page/homepage1/menu3.png" alt="Express Hava Kargo" style="width: 100%; max-width: 1100px; height: 450px; object-fit: cover; border-radius: 30px; box-shadow: 0 30px 60px rgba(0,0,0,0.15); position: relative; z-index: 3;">
                </div>
            </div>
        </section>

        <!-- 2. HİZMET DETAYLARI (Yatay Kutular - Express Odaklı) -->
        <section class="section pt-80 pb-100" style="background-color: #ffffff;">
            <div class="container">
                <div class="row justify-content-center mb-60">
                    <div class="col-lg-8 text-center">
                        <h2 class="mb-3" style="color: #0b1c3d;">Zamanla Yarışan Çözümler</h2>
                        <p class="font-lg" style="color: #64748b;">
                            Otomotiv yedek parçalarından tıbbi malzemelere, ihale evraklarından gemi yedek parçalarına (AOG / Ship Spares) kadar en acil yüklerinizi, standart prosedürlere takılmadan hedefine ulaştırıyoruz.
                        </p>
                    </div>
                </div>

                <!-- 2x2 Ferah Grid -->
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fcf4f4; border-radius: 20px; border: 1px solid #fae8e8; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">🚀</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Next Flight Out (NFO)</h4>
                                <p class="mb-0 text-muted">Kargonuz konsolidasyon beklemez. Müsait olan ilk tarifeli yolcu veya kargo uçağıyla anında havalanır.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fcf4f4; border-radius: 20px; border: 1px solid #fae8e8; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">⏱️</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Hızlı Gümrükleme</h4>
                                <p class="mb-0 text-muted">Zaman kaybetmemek için varış öncesi başlayan dokümantasyon ve "fast-track" gümrük geçişleri.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fcf4f4; border-radius: 20px; border: 1px solid #fae8e8; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">🎯</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Özel Kurye (OBC)</h4>
                                <p class="mb-0 text-muted">Çok hassas ve küçük paketleriniz için, uzman kuryemiz kargonuzla birlikte uçağa biner ve elden teslim eder.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex p-4" style="background: #fcf4f4; border-radius: 20px; border: 1px solid #fae8e8; transition: 0.3s;">
                            <div style="font-size: 40px; margin-right: 20px;">🛎️</div>
                            <div>
                                <h4 class="mb-2 color-brand-1">Dedicated Araçlar</h4>
                                <p class="mb-0 text-muted">Havalimanı ile teslimat noktası arasında, kargonuza özel tahsis edilmiş (paylaşımsız) ekspres araçlar.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. OPERASYON SÜRECİ (Karanlık Tema - Express Hızı) -->
        <section class="section pt-100 pb-120" style="background-color: #0b1c3d; color: white;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2 class="text-white">VIP Operasyon Süreci</h2>
                    <p style="color: #94a3b8;">Normal kargo bekleme sürelerinin ortadan kaldırıldığı premium döngü.</p>
                </div>

                <div class="row text-center position-relative mt-5">
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(255, 77, 77, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #ff4d4d; border: 2px solid #ff4d4d;">1</div>
                        <h5 class="text-white mb-3">Anında Aksiyon</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Talebiniz gelir gelmez dakikalar içinde en yakın araç adresinize yönlendirilir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(255, 77, 77, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #ff4d4d; border: 2px solid #ff4d4d;">2</div>
                        <h5 class="text-white mb-3">Öncelikli Kabul</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Havalimanında kuyruk beklemeden VIP X-Ray taramasından geçirilerek uçağa sevk edilir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: rgba(255, 77, 77, 0.1); border-radius: 50%; font-size: 24px; font-weight: bold; color: #ff4d4d; border: 2px solid #ff4d4d;">3</div>
                        <h5 class="text-white mb-3">İlk Uçakla Seyir</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Kargo aktarma merkezlerinde bekletilmez, kalkan ilk uygun uçağa yüklenir.</p>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <div class="mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; background: #ff4d4d; border-radius: 50%; font-size: 24px; font-weight: bold; color: #ffffff; border: 2px solid #ff4d4d;">4</div>
                        <h5 class="text-white mb-3">Direkt Teslimat</h5>
                        <p style="color: #cbd5e0; font-size: 14px;">Uçak teker koyduğu an gümrükten çekilip, beklemeden özel araçla alıcıya ulaştırılır.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. YÜZEN ÇAĞRI KUTUSU (Aciliyet Belirten CTA) -->
        <div class="container" style="margin-top: -60px; position: relative; z-index: 10;">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div style="background: linear-gradient(135deg, #e11d48 0%, #be123c 100%); border-radius: 20px; padding: 40px 50px; box-shadow: 0 20px 40px rgba(225, 29, 72, 0.3); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
                        <div class="mb-3 mb-md-0">
                            <h3 style="color: #ffffff; margin-bottom: 5px;">Zaman Kaybetmeyin!</h3>
                            <p style="color: #ffe4e6; margin-bottom: 0; font-size: 16px; font-weight: 500;">Dakikaların önemli olduğu sevkiyatlarınız için Express ekibimiz 7/24 hazır.</p>
                        </div>
                        <a href="/Contact/Index" class="btn hover-up" style="background: #ffffff; color: #e11d48; padding: 15px 35px; font-weight: bold; border-radius: 50px; font-size: 16px;">Acil Destek Hattı</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Alt Boşluk -->
        <div style="height: 100px; background-color: #ffffff;"></div>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
