@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #f8fafc; color: #333; line-height: 1.8; font-family: 'Segoe UI', sans-serif;">

        <!-- 1. GÖRKEMLİ HERO BÖLÜMÜ (Liman/Aktarma Teması) -->
        <section class="section pt-120 pb-120" style="position: relative; background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1494412574643-ff11b0a5c1c3?auto=format&fit=crop&q=80&w=1920') center/cover fixed;">
            <!-- Teknolojik Ağ Deseni -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(rgba(56, 189, 248, 0.1) 1px, transparent 1px); background-size: 30px 30px; z-index: 1;"></div>

            <div class="container text-center position-relative" style="z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(56, 189, 248, 0.15); color: #38bdf8; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 2px; font-size: 14px; border: 1px solid rgba(56, 189, 248, 0.3);">KOMBİNE LOJİSTİK MÜHENDİSLİĞİ</span>

                <h1 class="text-white mb-4" style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1;">
                    İntermodal <br> <span style="color: #38bdf8;">Taşımacılık</span>
                </h1>

                <p class="font-lg text-white opacity-75 mb-5 mx-auto" style="max-width: 780px;">
                    Yükünüzü taşıma kabından hiç çıkarmadan; Karayolu, Ro-Ro ve Demiryolu modlarını tek bir çatı altında kusursuzca entegre ediyor, maksimum verim ve minimum karbon ayak iziyle kapıdan kapıya (Door-to-Door) teslim ediyoruz.
                </p>

                <a href="/Contact/Index" class="btn" style="background: #38bdf8; color: #0f172a; padding: 16px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; border: none; box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3);">
                    Kombine Rota Planlayın
                </a>
            </div>
        </section>

        <!-- 2. İNTERMODAL MANTIĞI (Açıklayıcı ve Ferah Blok) -->
        <section class="section pt-100 pb-80" style="background-color: #ffffff;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                        <h2 class="mb-4" style="color: #0f172a; font-size: 2.5rem;">Sınırları Ortadan Kaldıran <br><span style="color: #38bdf8;">Akıllı Entegrasyon</span></h2>
                        <p class="text-muted font-lg mb-4">
                            İntermodal taşımacılık, sadece bir noktan diğerine yük götürmek değil; yolun ve coğrafyanın sunduğu en mantıklı taşıma şekillerini birleştirmektir.
                        </p>
                        <p class="text-muted font-lg mb-4">
                            Ürününüz kendi deponuzda <strong>45' HC Konteyner</strong> veya <strong>Swap Body (Değiştirilebilir Kasa)</strong> içine yüklenip mühürlenir. Yolculuk boyunca yükünüz fiziksel olarak hiç ellenmez, sadece taşıma ünitesi tırdan trene veya gemiye aktarılır. Bu da hasar riskini "sıfıra" indirir.
                        </p>
                        <div class="d-flex align-items-center p-3 mt-4" style="background: #f0f9ff; border-left: 4px solid #38bdf8; border-radius: 0 10px 10px 0;">
                            <div style="font-size: 24px; margin-right: 15px;">🛡️</div>
                            <p class="mb-0" style="color: #0c4a6e; font-weight: 500;">İçindeki yük değil, sadece taşıma kabı (konteyner) mod değiştirir.</p>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <!-- Gerçek Unsplash Görseli (Konteyner Aktarımı) -->
                        <img src="https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&q=80&w=800" alt="Konteyner Terminali" style="width: 100%; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. KUSURSUZ SÜREÇ HARİTASI (İntermodal Akışı) -->
        <section class="section pt-100 pb-100" style="background-color: #f8fafc;">
            <div class="container">
                <div class="text-center mb-80">
                    <h2 style="color: #0f172a;">Kapıdan Kapıya (Door-to-Door) Operasyon Akışı</h2>
                    <p class="text-muted font-lg">3 farklı taşıma modunun tek bir hedef için senkronize çalışması.</p>
                </div>

                <!-- Bağlantılı Node'lar (Görsel Süreç) -->
                <div class="row position-relative">
                    <!-- Arka plan bağlantı çizgisi (Sadece masaüstünde görünür) -->
                    <div class="d-none d-lg-block" style="position: absolute; top: 50px; left: 15%; right: 15%; height: 3px; background: linear-gradient(90deg, #38bdf8 0%, #10b981 50%, #38bdf8 100%); z-index: 1; opacity: 0.5; border-radius: 3px;"></div>

                    <!-- Adım 1: İlk Kilometre -->
                    <div class="col-lg-4 text-center mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: #ffffff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border: 4px solid #38bdf8; font-size: 35px;">🚛</div>
                        <span style="background: #e0f2fe; color: #0284c7; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; margin-bottom: 10px; display: inline-block;">İLK KİLOMETRE</span>
                        <h4 class="mb-3" style="color: #0f172a;">Karayolu Alımı</h4>
                        <p class="text-muted px-3">Yükünüz fabrikanızdan tırlarla alınarak en yakın demiryolu veya Ro-Ro terminaline güvenle transfer edilir.</p>
                    </div>

                    <!-- Adım 2: Ana Taşıma -->
                    <div class="col-lg-4 text-center mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: #ffffff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border: 4px solid #10b981; font-size: 35px;">🚢 / 🚆</div>
                        <span style="background: #d1fae5; color: #059669; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; margin-bottom: 10px; display: inline-block;">ANA GÜZERGAH</span>
                        <h4 class="mb-3" style="color: #0f172a;">Ro-Ro ve Demiryolu</h4>
                        <p class="text-muted px-3">Terminaldeki ekipmanlar trene veya Ro-Ro gemisine aktarılır. Uzun mesafe trafiğe ve sınır kapılarına takılmadan aşılır.</p>
                    </div>

                    <!-- Adım 3: Son Kilometre -->
                    <div class="col-lg-4 text-center position-relative" style="z-index: 2;">
                        <div class="mx-auto d-flex align-items-center justify-content-center mb-4" style="width: 100px; height: 100px; background: #ffffff; border-radius: 50%; box-shadow: 0 10px 25px rgba(0,0,0,0.1); border: 4px solid #38bdf8; font-size: 35px;">🏭</div>
                        <span style="background: #e0f2fe; color: #0284c7; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; margin-bottom: 10px; display: inline-block;">SON KİLOMETRE</span>
                        <h4 class="mb-3" style="color: #0f172a;">Kapıya Teslimat</h4>
                        <p class="text-muted px-3">Varış terminaline ulaşan ekipman, tekrar tır çekicilerine alınarak alıcının gümrüğüne ve nihai deposuna teslim edilir.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. AVANTAJLAR (Premium Grid) -->
        <section class="section pt-80 pb-100" style="background-color: #1e293b; color: white;">
            <div class="container">
                <div class="row align-items-center mb-60">
                    <div class="col-lg-6">
                        <h2 class="text-white mb-0">Neden İntermodal <br>Taşımacılığı Seçmelisiniz?</h2>
                    </div>
                    <div class="col-lg-6 text-lg-end mt-4 mt-lg-0">
                        <p style="color: #94a3b8; margin-bottom: 0;">Hem şirketinizin bütçesini hem de doğayı koruyan <br>geleceğin taşımacılık modeli.</p>
                    </div>
                </div>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="p-5" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 15px; transition: 0.3s; height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 20px; display: inline-block; background: rgba(56, 189, 248, 0.2); width: 70px; height: 70px; text-align: center; line-height: 70px; border-radius: 15px;">💰</div>
                            <h4 class="text-white mb-3">Maliyet Optimizasyonu</h4>
                            <p style="color: #94a3b8; mb-0">Özellikle uzun mesafelerde, karayolundaki yakıt dalgalanmalarından ve geçiş ücretlerinden (Toll) etkilenmeyerek sabit ve rekabetçi navlun avantajı sağlar.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-5" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 15px; transition: 0.3s; height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 20px; display: inline-block; background: rgba(16, 185, 129, 0.2); width: 70px; height: 70px; text-align: center; line-height: 70px; border-radius: 15px;">🌍</div>
                            <h4 class="text-white mb-3">Sürdürülebilirlik (Yeşil Lojistik)</h4>
                            <p style="color: #94a3b8; mb-0">Sadece tır kullanımına kıyasla Karbon (CO2) emisyonlarında %75'e varan azalma sağlayarak markanızın çevresel sürdürülebilirlik hedeflerine katkıda bulunur.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-5" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 15px; transition: 0.3s; height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 20px; display: inline-block; background: rgba(245, 158, 11, 0.2); width: 70px; height: 70px; text-align: center; line-height: 70px; border-radius: 15px;">⏱️</div>
                            <h4 class="text-white mb-3">Zaman Çizelgesine Sadakat</h4>
                            <p style="color: #94a3b8; mb-0">Tren ve Ro-Ro gemileri belirli bir tarifeye göre hareket eder. Sınır kapısı beklemeleri, sürüş yasağı ve trafik gibi karayolu kısıtlamalarına takılmaz.</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-5" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 15px; transition: 0.3s; height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 20px; display: inline-block; background: rgba(236, 72, 153, 0.2); width: 70px; height: 70px; text-align: center; line-height: 70px; border-radius: 15px;">📦</div>
                            <h4 class="text-white mb-3">Büyük Ekipman Kapasitesi</h4>
                            <p style="color: #94a3b8; mb-0">Özel yatırımımız olan 45'lik High Cube Konteynerler ve Swap Body'ler sayesinde standart tır dorsesi hacminde (100 m³) yükleme imkanı.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. ÇAĞRI (CTA) -->
        <section class="section pt-80 pb-80 text-center" style="background: #ffffff; border-top: 5px solid #38bdf8;">
            <div class="container">
                <h2 class="mb-4" style="color: #0f172a;">Lojistikte Geleceğe Geçiş Yapın</h2>
                <p class="font-lg mb-5 mx-auto text-muted" style="max-width: 650px;">Avrupa ve Asya operasyonlarınız için size özel maliyet ve emisyon tasarrufu analizi hazırlayalım.</p>
                <a href="/Contact/Index" class="btn" style="background: #0f172a; color: white; padding: 18px 50px; font-weight: bold; border-radius: 8px; font-size: 18px; box-shadow: 0 10px 20px rgba(0,0,0,0.15);">İntermodal Fiyat Teklifi Al</a>
            </div>
        </section>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
