@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #ffffff; color: #333; line-height: 1.8;">

        <!-- 1. GÖRKEMLİ HERO (Devasa Yükler İçin Premium Giriş) -->
        <section class="section" style="padding: 160px 0; background: linear-gradient(rgba(11, 28, 61, 0.85), rgba(11, 28, 61, 0.85)), url('/templates/assets/imgs/page/homepage1/menu1.png') center/cover fixed;">
            <div class="container text-center">
                <span class="text-uppercase fw-bold" style="color: #ffbc00; letter-spacing: 4px;">Mühendislik ve Lojistiğin Zirvesi</span>
                <h1 class="text-white mt-3 mb-4" style="font-size: 4rem; font-weight: 900;">Proje Kargo Taşımacılığı</h1>
                <p class="text-white opacity-75 font-lg" style="max-width: 800px; margin: 0 auto;">
                    Fabrika taşımalarından dev enerji santrallerine kadar; gabari dışı ve ağır tonajlı yükleriniz için sıfır hata prensibiyle "anahtar teslim" proje yönetimi.
                </p>
            </div>
        </section>

        <!-- 2. DETAYLI METİN VE MÜHENDİSLİK VURGUSU -->
        <section class="section pt-100 pb-100">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6">
                        <h2 class="mb-4" style="font-size: 2.5rem; color: #0b1c3d;">Sınırları Aşan Projelerde Stratejik Ortaklık</h2>
                        <p class="font-lg color-grey-700 mb-4">
                            Proje kargo taşımacılığı, standart lojistik kalıplarının tamamen dışına çıkan; detaylı mühendislik hesaplamaları, yasal izinler ve kusursuz operasyonel zamanlama gerektiren özel bir disiplindir.
                            Rüzgar türbinleri, dev transformatörler, endüstriyel tesis bileşenleri ve rafineri ekipmanları gibi kritik yükleri kıtalar arası taşıyoruz.
                        </p>
                        <p class="font-lg color-grey-700">
                            Süreci sadece bir "taşıma" olarak değil, bir <strong>"proje yönetimi"</strong> olarak ele alıyoruz. Multimodal taşıma modellerini (deniz, kara, nehir, demiryolu) entegre ederek, yükün üretim tesisinden şantiyedeki montaj alanına kadar olan tüm yolculuğunu uçtan uca koordine ediyoruz.
                        </p>
                    </div>
                    <div class="col-lg-6">
                        <img src="/templates/assets/imgs/page/homepage1/menu5.png" alt="Proje Kargo Operasyonu" style="width: 100%; border-radius: 20px; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. OPERASYONEL GÜVENLİK (Özellik Kartları) -->
        <section class="section pt-100 pb-100" style="background-color: #f8f9fa;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2>Proje Kargoda "Sıfır Hata" Yaklaşımımız</h2>
                </div>
                <div class="row">
                    <div class="col-lg-4 text-center">
                        <div class="p-4" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 15px;">🗺️</div>
                            <h4 class="mb-3 color-brand-1">Güzergah & Risk Analizi</h4>
                            <p class="text-muted">Köprü dayanımları, yol genişlikleri ve viraj eğimleri gibi tüm yol etütleri milimetrik olarak önceden analiz edilir.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="p-4" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 15px;">🚢</div>
                            <h4 class="mb-3 color-brand-1">Multimodal Çözümler</h4>
                            <p class="text-muted">Deniz, nehir, demiryolu ve karayolunun tek bir projede kusursuz şekilde entegre edilmesiyle maliyet ve zaman avantajı.</p>
                        </div>
                    </div>
                    <div class="col-lg-4 text-center">
                        <div class="p-4" style="background: white; border-radius: 20px; padding: 30px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); height: 100%;">
                            <div style="font-size: 40px; margin-bottom: 15px;">🏗️</div>
                            <h4 class="mb-3 color-brand-1">Anahtar Teslim (Turnkey)</h4>
                            <p class="text-muted">Gümrükleme, ağır tonajlı vinç operasyonları, lashing ve şantiye teslimatı süreçlerinin tek elden yönetilmesi.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. ÇAĞRI (CTA) -->
        <section class="section pt-80 pb-80 text-center" style="background: #0b1c3d; color: white;">
            <div class="container">
                <h2 class="mb-4">Dev Projeleriniz İçin Uzman Desteği Alın</h2>
                <p class="font-lg mb-4" style="color: #cbd5e0;">Gabari dışı ve ağır tonajlı yükleriniz için projenize özel lojistik fizibilite çalışması yapalım.</p>
                <a href="/Contact/Index" class="btn btn-brand-1" style="padding: 15px 40px; font-weight: bold; font-size: 1.1rem;">Proje Dosyanızı Gönderin</a>
            </div>
        </section>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
