@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #f8fafc; color: #333; line-height: 1.8; font-family: 'Segoe UI', sans-serif;">

        <!-- 1. GÖRKEMLİ HERO BÖLÜMÜ (Kurumsal Danışmanlık ve Analiz Teması) -->
        <section class="section pt-120 pb-120" style="position: relative; background: linear-gradient(rgba(15, 23, 42, 0.85), rgba(15, 23, 42, 0.95)), url('https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1920') center/cover fixed;">
            <!-- Analitik Veri / Nokta Deseni -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(rgba(14, 165, 233, 0.15) 1px, transparent 1px); background-size: 30px 30px; z-index: 1;"></div>

            <div class="container text-center position-relative" style="z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(14, 165, 233, 0.15); color: #38bdf8; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 2px; font-size: 14px; border: 1px solid rgba(14, 165, 233, 0.3);">STRATEJİK LOJİSTİK MÜHENDİSLİĞİ</span>

                <h1 class="text-white mb-4" style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1;">
                    Demiryolu Lojistik <br> <span style="color: #38bdf8;">Danışmanlığı</span>
                </h1>

                <p class="font-lg text-white opacity-75 mb-5 mx-auto" style="max-width: 800px;">
                    Karmaşık tedarik zincirlerinizi, uluslararası demiryolu mevzuatlarını ve yüksek maliyetli operasyonlarınızı veriye dayalı mühendislik yaklaşımlarıyla analiz ediyor; şirketinize özel, sürdürülebilir ve kârlı lojistik modelleri tasarlıyoruz.
                </p>

                <a href="/Contact/Index" class="btn" style="background: #0ea5e9; color: white; padding: 16px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; border: none; box-shadow: 0 10px 20px rgba(14, 165, 233, 0.3);">
                    Ücretsiz Ön Analiz Talep Et
                </a>
            </div>
        </section>

        <!-- 2. KONSEPT AÇIKLAMASI (Neden Danışmanlık?) -->
        <section class="section pt-100 pb-80" style="background-color: #ffffff;">
            <div class="container">
                <div class="row align-items-center">
                    <div class="col-lg-6 mb-5 mb-lg-0 pe-lg-5">
                        <h2 class="mb-4" style="color: #0f172a; font-size: 2.5rem;">Sıfır Hata, <br><span style="color: #0ea5e9;">Maksimum Verim</span></h2>
                        <p class="text-muted font-lg mb-4">
                            Demiryolu yatırımları ve uluslararası taşıma operasyonları, şirketler için büyük bütçeli ve yüksek riskli süreçlerdir. Hatalı bir vagon seçimi, yanlış kurgulanmış bir gümrük süreci veya hesaplanmamış bir hat farkı, operasyonu kâbusa çevirebilir.
                        </p>
                        <p class="text-muted font-lg mb-4">
                            ÇokkeçeciJET uzmanları; sadece yükünüzü taşımakla kalmaz, işin "mutfağına" girerek süreçlerinizi baştan aşağı röntgenler. Karar verme süreçlerinizi hislere değil, kesin ve ölçülebilir <strong>maliyet-fayda (ROI) analizlerine</strong> dayandırmanızı sağlar.
                        </p>
                        <div class="d-flex align-items-center p-3 mt-4" style="background: #f0f9ff; border-left: 4px solid #0ea5e9; border-radius: 0 10px 10px 0;">
                            <div style="font-size: 24px; margin-right: 15px;">📊</div>
                            <p class="mb-0" style="color: #0369a1; font-weight: 500;">Operasyonel maliyetlerinizi düşürürken, karbon ayak izinizi küçültüyoruz.</p>
                        </div>
                    </div>
                    <div class="col-lg-6 position-relative">
                        <!-- Gerçek Unsplash Görseli (Toplantı/Analiz) -->
                        <div style="position: relative; border-radius: 20px; overflow: hidden; box-shadow: 0 20px 40px rgba(0,0,0,0.15);">
                            <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&q=80&w=800" alt="Lojistik Toplantısı ve Analiz" style="width: 100%; display: block;">
                            <!-- Veri Vurgusu Kutusu -->
                            <div style="position: absolute; bottom: 30px; left: -20px; background: #ffffff; padding: 20px; border-radius: 15px; box-shadow: 0 15px 30px rgba(0,0,0,0.1); border-left: 4px solid #0ea5e9; max-width: 280px; z-index: 3;">
                                <div class="d-flex align-items-center mb-2">
                                    <h4 class="mb-0 mr-10" style="color: #0f172a; font-weight: 800;">%35</h4>
                                    <span style="color: #10b981; font-size: 20px;">📉</span>
                                </div>
                                <p class="text-muted font-sm mb-0">Ortalama operasyonel maliyet tasarrufu.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. DANIŞMANLIK HİZMET BAŞLIKLARI (Şık Analitik Grid) -->
        <section class="section pt-80 pb-100" style="background-color: #f8fafc;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2 style="color: #0f172a;">Danışmanlık Portföyümüz</h2>
                    <p class="text-muted font-lg">Tedarik zincirinizi demirağlarla optimize eden stratejik hizmetlerimiz.</p>
                </div>

                <div class="row g-4">
                    <!-- Fizibilite -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">📑</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Fizibilite ve Maliyet Analizi</h4>
                            <p class="text-muted font-sm mb-0">Taşımacılık projelerinizin uygulanabilirliğini, karayolu/denizyolu kıyaslamalarını ve bütçe sapma risklerini bilimsel yöntemlerle raporluyoruz.</p>
                        </div>
                    </div>

                    <!-- Mevzuat -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">⚖️</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Uluslararası Demiryolu Hukuku</h4>
                            <p class="text-muted font-sm mb-0">CIM, SMGS ve COTIF gibi uluslararası sözleşmeler kapsamında yasal haklarınızı koruyor, sınır ötesi gümrük prosedürlerini firmanız adına kurguluyoruz.</p>
                        </div>
                    </div>

                    <!-- Hat Planlama -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">🛤️</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Blok Tren & Rota Tasarımı</h4>
                            <p class="text-muted font-sm mb-0">Sürekli ve yüksek hacimli yükleriniz için size özel blok tren güzergahları tasarlıyor, aktarma noktalarındaki zaman kayıplarını sıfırlıyoruz.</p>
                        </div>
                    </div>

                    <!-- Altyapı Yatırım -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">🏗️</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Terminal ve İltisak Hattı</h4>
                            <p class="text-muted font-sm mb-0">Fabrikanızın veya antreponuzun içine çekilecek özel demiryolu hatlarının (iltisak hattı) mühendislik, izin ve projelendirme süreçlerini yönetiyoruz.</p>
                        </div>
                    </div>

                    <!-- Yük Güvenliği -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">⛓️</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Yük Güvenliği & Lashing Analizi</h4>
                            <p class="text-muted font-sm mb-0">Tehlikeli maddeler (RID) veya gabari dışı yüklerinizin vagonlara uluslararası güvenlik normlarına uygun istiflenmesi için mühendislik raporları hazırlıyoruz.</p>
                        </div>
                    </div>

                    <!-- Sürdürülebilirlik -->
                    <div class="col-lg-4 col-md-6">
                        <div class="p-5" style="background: #ffffff; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.04); height: 100%; transition: 0.3s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                            <div style="background: #f0f9ff; width: 70px; height: 70px; border-radius: 15px; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #0ea5e9; margin-bottom: 25px;">🌱</div>
                            <h4 style="color: #0f172a; margin-bottom: 15px;">Yeşil Lojistik Çözümleri</h4>
                            <p class="text-muted font-sm mb-0">Karbon ayak izinizi hesaplıyor, Avrupa Yeşil Mutabakatı'na (Green Deal) uyum sağlamanız için çevreci intermodal dönüşüm planları sunuyoruz.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. ÇALIŞMA METODOLOJİSİ (Aşamalı Kurumsal Akış) -->
        <section class="section pt-100 pb-100" style="background-color: #1e293b; color: white;">
            <div class="container">
                <div class="text-center mb-80">
                    <h2 class="text-white">Danışmanlık Metodolojimiz</h2>
                    <p style="color: #94a3b8;">Verinin gücüyle adım adım başarıya ulaşan süreç yönetimimiz.</p>
                </div>

                <div class="row position-relative text-center">
                    <!-- Bağlantı Çizgisi (Sadece Masaüstü) -->
                    <div class="d-none d-lg-block" style="position: absolute; top: 40px; left: 10%; width: 80%; border-top: 2px dashed rgba(14, 165, 233, 0.4); z-index: 1;"></div>

                    <!-- Adım 1 -->
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #0f172a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; border: 3px solid #0ea5e9; color: #0ea5e9;">🔍</div>
                        <h5 class="text-white mb-2">1. Mevcut Durum Analizi</h5>
                        <p style="color: #94a3b8; font-size: 14px; padding: 0 10px;">Firmanızın mevcut taşıma verileri, rotaları ve maliyetleri incelenerek "As-Is" (Mevcut Durum) haritası çıkarılır.</p>
                    </div>

                    <!-- Adım 2 -->
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #0f172a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; border: 3px solid #0ea5e9; color: #0ea5e9;">📐</div>
                        <h5 class="text-white mb-2">2. Çözüm Tasarımı</h5>
                        <p style="color: #94a3b8; font-size: 14px; padding: 0 10px;">Alternatif demiryolu senaryoları simüle edilir, risk ve bütçe analizleri yapılarak en uygun model tasarlanır.</p>
                    </div>

                    <!-- Adım 3 -->
                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #0f172a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; border: 3px solid #0ea5e9; color: #0ea5e9;">⚙️</div>
                        <h5 class="text-white mb-2">3. Uygulama & Entegrasyon</h5>
                        <p style="color: #94a3b8; font-size: 14px; padding: 0 10px;">Gerekli sözleşmeler, acente anlaşmaları ve yasal izinler alınarak planlanan model sahada fiilen hayata geçirilir.</p>
                    </div>

                    <!-- Adım 4 -->
                    <div class="col-lg-3 col-md-6 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #0ea5e9; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28px; border: 3px solid #0ea5e9; color: white; box-shadow: 0 0 20px rgba(14, 165, 233, 0.4);">📈</div>
                        <h5 class="text-white mb-2">4. Takip ve Optimizasyon</h5>
                        <p style="color: #94a3b8; font-size: 14px; padding: 0 10px;">Süreçler KPI (Performans Göstergeleri) ile izlenir ve verimliliği artırmak için sürekli iyileştirmeler (Kaizen) yapılır.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. GÜÇLÜ CTA BÖLÜMÜ (Randevu Odaklı) -->
        <section class="section pt-80 pb-80 text-center" style="background: #ffffff; border-top: 5px solid #0ea5e9;">
            <div class="container">
                <h2 class="mb-4" style="color: #0f172a;">Lojistik Bütçenizi Riske Atmayın</h2>
                <p class="font-lg mb-5 mx-auto text-muted" style="max-width: 600px;">Büyük projelerin büyük doğrulara ihtiyacı vardır. Demiryolu operasyonlarınızı tasarlamak için Lojistik Mühendislerimizden hemen randevu alın.</p>
                <div class="d-flex justify-content-center gap-3 flex-wrap">
                    <a href="/Contact/Index" class="btn" style="background: #0ea5e9; color: white; padding: 18px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; box-shadow: 0 10px 20px rgba(14, 165, 233, 0.3);">Danışmanla İletişime Geç</a>
                    <a href="tel:0850xxxxxxx" class="btn" style="background: #ffffff; color: #0f172a; padding: 18px 45px; font-weight: bold; border-radius: 8px; font-size: 16px; border: 2px solid #e2e8f0;">Bizi Arayın: 0850 XXX XX XX</a>
                </div>
            </div>
        </section>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>