@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
@await Component.InvokeAsync("_DefaultHeadComponentPartial")
<body>
    @await Component.InvokeAsync("_DefaultBoxBarComponentPartial")
    @await Component.InvokeAsync("_DefaultHeaderComponentPartial")
    @await Component.InvokeAsync("_DefaultMobileMenuComponentPartial")

    <main class="main" style="background-color: #fbfbfb; color: #333; line-height: 1.8; font-family: 'Segoe UI', sans-serif;">

        <!-- 1. GÖRKEMLİ HERO BÖLÜMÜ (VIP ve Premium Tema) -->
        <section class="section pt-120 pb-120" style="position: relative; background: linear-gradient(rgba(17, 17, 17, 0.85), rgba(10, 10, 10, 0.95)), url('https://images.unsplash.com/photo-1506015391300-4802bfcecb65?auto=format&fit=crop&q=80&w=1920') center/cover fixed;">
            <!-- Zemin Deseni (Zarif Grid) -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-image: radial-gradient(rgba(212, 175, 55, 0.15) 1px, transparent 1px); background-size: 50px 50px; z-index: 1;"></div>

            <div class="container text-center position-relative" style="z-index: 2;">
                <span class="d-inline-block mb-3" style="background: rgba(212, 175, 55, 0.15); color: #d4af37; padding: 8px 25px; border-radius: 50px; font-weight: 700; letter-spacing: 3px; font-size: 13px; border: 1px solid rgba(212, 175, 55, 0.4); text-transform: uppercase;">Ayrıcalıklı Lojistik Çözümleri</span>

                <h1 class="text-white mb-4" style="font-size: clamp(3rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1;">
                    Özel Taşımacılık <br> <span style="color: #d4af37; font-family: 'Playfair Display', serif; font-style: italic;">(Bespoke Logistics)</span>
                </h1>

                <p class="font-lg text-white opacity-75 mb-5 mx-auto" style="max-width: 750px;">
                    Standartların yetersiz kaldığı anlarda; paha biçilemez sanat eserlerinden diplomatik kargolara, fuar lojistiğinden canlı hayvan transferlerine kadar projenize özel, "terzi işi" VIP taşıma hizmeti sunuyoruz.
                </p>

                <a href="/Contact/Index" class="btn" style="background: #d4af37; color: #111111; padding: 18px 50px; font-weight: bold; border-radius: 50px; font-size: 16px; border: none; box-shadow: 0 10px 30px rgba(212, 175, 55, 0.3); text-transform: uppercase; letter-spacing: 1px;">
                    VIP Danışmanlık Alın
                </a>
            </div>
        </section>

        <!-- 2. "WHITE-GLOVE" KONSEPTİ (Şık ve Asimetrik Tasarım) -->
        <section class="section pt-100 pb-80" style="background-color: #ffffff;">
            <div class="container">
                <div class="row align-items-center flex-row-reverse">
                    <div class="col-lg-6 mb-5 mb-lg-0 ps-lg-5">
                        <h2 class="mb-4" style="color: #111111; font-size: 2.5rem;">Sıfır Risk, <br><span style="color: #d4af37;">Mutlak Hassasiyet</span></h2>
                        <p class="text-muted font-lg mb-4">
                            Özel taşımacılık, yükünüzün "A noktasından B noktasına gitmesinden" çok daha fazlasıdır. Bu hizmet; güvenlik protokolleri, iklimlendirme sistemleri ve milimetrik zamanlama gerektiren bir <strong>Mühendislik ve Güvenlik</strong> sanatıdır.
                        </p>
                        <p class="text-muted font-lg mb-4">
                            "White-Glove" (Beyaz Eldiven) prensibimizle; kargonuzun paketlenmesinden gümrükteki özel izinlerine, gerekirse silahlı eskort refakatinden varış noktasındaki montajına kadar tüm detayları şahsa/kuruma özel olarak planlıyoruz.
                        </p>
                        <div class="d-flex align-items-center p-4 mt-4" style="background: #faf8f5; border-left: 4px solid #d4af37; border-radius: 0 15px 15px 0;">
                            <div style="font-size: 30px; margin-right: 20px;">💎</div>
                            <div>
                                <h5 style="color: #111111; margin-bottom: 5px;">Sadece Size Özel Hizmet</h5>
                                <p class="mb-0" style="color: #666; font-size: 14px;">Kargonuz asla başka yüklerle konsolide edilmez, bağımsız ve direkt transfer sağlanır.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6 position-relative">
                        <!-- Gerçek Unsplash Görseli (Premium Kutu/Paketleme) -->
                        <div style="border-radius: 20px; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.1);">
                            <img src="https://images.unsplash.com/photo-1616423640778-28d1b53229bd?auto=format&fit=crop&q=80&w=800" alt="Hassas Kargo Paketleme" style="width: 100%; display: block; filter: contrast(1.1);">
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 3. ÖZEL UZMANLIK ALANLARI (Premium Grid) -->
        <section class="section pt-80 pb-100" style="background-color: #fbfbfb;">
            <div class="container">
                <div class="text-center mb-60">
                    <h2 style="color: #111111;">Uzmanlık Alanlarımız</h2>
                    <p class="text-muted font-lg">Her biri farklı kurallar ve sertifikalar gerektiren VIP lojistik dalları.</p>
                </div>

                <div class="row g-4">
                    <!-- Sanat Eseri -->
                    <div class="col-lg-6">
                        <div class="d-flex p-5" style="background: #ffffff; border-radius: 20px; border: 1px solid #f0e6d2; box-shadow: 0 10px 30px rgba(0,0,0,0.03); transition: 0.3s; height: 100%;">
                            <div style="font-size: 45px; margin-right: 25px; line-height: 1;">🖼️</div>
                            <div>
                                <h4 class="mb-3" style="color: #111111;">Sanat Eseri & Antika</h4>
                                <p class="text-muted mb-0">Tablolar, heykeller ve paha biçilemez antikalar için; titreşim önleyici süspansiyonlu araçlar, özel iklimlendirmeli kasalar (Crate) ve müze standartlarında taşıma.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Fuar & Etkinlik -->
                    <div class="col-lg-6">
                        <div class="d-flex p-5" style="background: #ffffff; border-radius: 20px; border: 1px solid #f0e6d2; box-shadow: 0 10px 30px rgba(0,0,0,0.03); transition: 0.3s; height: 100%;">
                            <div style="font-size: 45px; margin-right: 25px; line-height: 1;">🎪</div>
                            <div>
                                <h4 class="mb-3" style="color: #111111;">Fuar & Etkinlik (Event)</h4>
                                <p class="text-muted mb-0">Konser ekipmanları, sahne sistemleri veya uluslararası fuar standlarınızın ATA Karnesi ile geçici ithalat/ihracatı ve standa teslim kurulumu.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Canlı Hayvan -->
                    <div class="col-lg-6">
                        <div class="d-flex p-5" style="background: #ffffff; border-radius: 20px; border: 1px solid #f0e6d2; box-shadow: 0 10px 30px rgba(0,0,0,0.03); transition: 0.3s; height: 100%;">
                            <div style="font-size: 45px; margin-right: 25px; line-height: 1;">🐎</div>
                            <div>
                                <h4 class="mb-3" style="color: #111111;">Canlı Hayvan (AVI)</h4>
                                <p class="text-muted mb-0">Yarış atları, egzotik hayvanlar veya evcil dostlarınız için IATA Live Animals Regulations (LAR) standartlarına uygun, stressiz ve veteriner onaylı nakliye.</p>
                            </div>
                        </div>
                    </div>
                    <!-- Diplomatik & Gizli -->
                    <div class="col-lg-6">
                        <div class="d-flex p-5" style="background: #ffffff; border-radius: 20px; border: 1px solid #f0e6d2; box-shadow: 0 10px 30px rgba(0,0,0,0.03); transition: 0.3s; height: 100%;">
                            <div style="font-size: 45px; margin-right: 25px; line-height: 1;">💼</div>
                            <div>
                                <h4 class="mb-3" style="color: #111111;">Diplomatik & Gizli Kargo</h4>
                                <p class="text-muted mb-0">Hükümet yetkilileri, elçilikler veya kurumsal firmalar için; x-ray muafiyeti (gerekli izinlerle), yüksek gizlilik ve silahlı eskort eşliğinde teslimat.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 4. WHITE-GLOVE OPERASYON SÜRECİ (Siyah & Altın Tema) -->
        <section class="section pt-100 pb-120" style="background-color: #111111; color: white;">
            <div class="container">
                <div class="text-center mb-80">
                    <h2 style="color: #d4af37; font-family: 'Playfair Display', serif; font-style: italic;">"Beyaz Eldiven" Sürecimiz</h2>
                    <p style="color: #888888;">Operasyonun her saniyesinin sizin için kurgulandığı elit teslimat adımları.</p>
                </div>

                <div class="row text-center position-relative">
                    <!-- Altın Çizgi (Sadece Masaüstü) -->
                    <div class="d-none d-lg-block" style="position: absolute; top: 40px; left: 12%; width: 76%; height: 2px; background: linear-gradient(90deg, transparent, #d4af37, transparent); z-index: 1; opacity: 0.3;"></div>

                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #1a1a1a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; color: #d4af37; border: 2px solid #d4af37; box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);">1</div>
                        <h5 class="text-white mb-3">Gizlilik & Keşif</h5>
                        <p style="color: #999; font-size: 14px;">Talebiniz gizlilik anlaşmasıyla (NDA) alınır. Ürün yerinde incelenir ve risk analizi yapılır.</p>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #1a1a1a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; color: #d4af37; border: 2px solid #d4af37; box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);">2</div>
                        <h5 class="text-white mb-3">Özel Üretim Kasa</h5>
                        <p style="color: #999; font-size: 14px;">Ürünün 3D yapısına, ısı ve nem hassasiyetine uygun darbe emici özel ahşap/metal kasalar üretilir.</p>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-5 mb-lg-0 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #1a1a1a; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; color: #d4af37; border: 2px solid #d4af37; box-shadow: 0 0 20px rgba(212, 175, 55, 0.2);">3</div>
                        <h5 class="text-white mb-3">VIP Transfer</h5>
                        <p style="color: #999; font-size: 14px;">Havalı süspansiyonlu araçlar veya özel jet kargo ile sarsıntısız ve 7/24 uydudan izlenen seyahat.</p>
                    </div>

                    <div class="col-lg-3 col-md-6 position-relative" style="z-index: 2;">
                        <div class="mx-auto mb-4" style="width: 80px; height: 80px; background: #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: bold; color: #111111; border: 2px solid #d4af37; box-shadow: 0 0 30px rgba(212, 175, 55, 0.4);">4</div>
                        <h5 class="text-white mb-3">Elden Teslim & Kurulum</h5>
                        <p style="color: #999; font-size: 14px;">Uzman personelimiz kargoyu ambalajından çıkarır, istenen alana kurar ve atıkları temizler.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. PRESTİJLİ CTA -->
        <section class="section" style="padding: 100px 0; background: url('https://images.unsplash.com/photo-1542296332-2e4473faf563?auto=format&fit=crop&q=80&w=1920') center/cover; position: relative;">
            <!-- Altın Tonlu Karanlık Katman -->
            <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(135deg, rgba(17, 17, 17, 0.95) 0%, rgba(30, 25, 15, 0.9) 100%);"></div>

            <div class="container position-relative text-center" style="z-index: 2;">
                <div style="font-size: 40px; margin-bottom: 20px; color: #d4af37;">👑</div>
                <h2 class="text-white mb-4" style="font-size: 2.8rem; font-family: 'Playfair Display', serif;">Paha Biçilemez Yükler İçin <br>Kusursuz Partner</h2>
                <p class="text-white opacity-75 font-lg mb-5 mx-auto" style="max-width: 600px;">
                    Projelerinizin hassasiyetini anlıyoruz. Detayları görüşmek ve gizlilik politikamız (NDA) kapsamında özel fiyatlandırma almak için bize ulaşın.
                </p>
                <a href="/Contact/Index" class="btn" style="background: transparent; color: #d4af37; padding: 18px 50px; font-weight: bold; border-radius: 0px; font-size: 16px; border: 2px solid #d4af37; text-transform: uppercase; letter-spacing: 2px; transition: all 0.3s;" onmouseover="this.style.background='#d4af37'; this.style.color='#111'" onmouseout="this.style.background='transparent'; this.style.color='#d4af37'">
                    Özel Müşteri Temsilcisi
                </a>
            </div>
        </section>

    </main>

    @await Component.InvokeAsync("_DefaultFooterComponentPartial")
    @await Component.InvokeAsync("_DefaultScriptsComponentPartial")
</body>
</html>
